<UserControl
    x:Class="ReInvented.StaadPro.Interop.Parametric.Controls.CircularBasePlate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <GroupBox Padding="5" Header="Add Components">
            <StackPanel Margin="0,5">
                <CheckBox
                    Margin="0,5"
                    Content="Base Plate"
                    IsChecked="True"
                    IsEnabled="False" />
                <CheckBox
                    Margin="0,5"
                    Content="Anchor Chair Plate"
                    IsChecked="False"
                    IsEnabled="False" />
                <CheckBox Margin="0,5" Content="Column" />
                <CheckBox Margin="0,5" Content="Bolt Holes" />
                <CheckBox Margin="0,5" Content="Stiffeners" />
            </StackPanel>
        </GroupBox>
        <GroupBox
            Grid.Column="2"
            Margin="5,0,0,0"
            Header="Geometry Input">
            <WrapPanel>
                <GroupBox Width="200" Header="Base Plate" />
            </WrapPanel>
        </GroupBox>
    </Grid>
</UserControl>
