@page
@model LinguistPro.Pages.Account.ManageLanguagesModel
@{
    ViewData["Title"] = "Manage Languages";
    Layout = "_Layout";
}

<div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100">
    <!-- Header -->
    <div class="bg-white border-b border-slate-200">
        <div class="max-w-6xl mx-auto px-6 py-6 flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-bold text-slate-900">Manage Languages</h1>
                <p class="text-slate-500 mt-1">Add, remove, and manage your language profiles</p>
            </div>
            <a href="/Account/Profile" class="px-4 py-2 text-slate-600 hover:text-slate-900 font-medium transition">← Back</a>
        </div>
    </div>

    <div class="max-w-6xl mx-auto px-6 py-12">
        <!-- Success Message -->
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="mb-8 p-4 bg-emerald-50 border border-emerald-200 rounded-lg flex items-start gap-3">
                <span class="text-2xl mt-1">✓</span>
                <div>
                    <p class="text-emerald-900 font-semibold">Success</p>
                    <p class="text-emerald-700 text-sm">@Model.SuccessMessage</p>
                </div>
            </div>
        }

        <!-- Error Message -->
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="mb-8 p-4 bg-red-50 border border-red-200 rounded-lg flex items-start gap-3">
                <span class="text-2xl mt-1">✗</span>
                <div>
                    <p class="text-red-900 font-semibold">Error</p>
                    <p class="text-red-700 text-sm">@Model.ErrorMessage</p>
                </div>
            </div>
        }

        <!-- Add New Language Section -->
        @if (Model.AvailableLanguages.Count > 0)
        {
            <div class="bg-white rounded-lg border border-slate-200 p-6 mb-12">
                <h2 class="text-lg font-bold text-slate-900 mb-6 flex items-center gap-2">
                    <span class="text-2xl">➕</span> Add New Language
                </h2>
                <form method="post" asp-page-handler="AddLanguage" class="flex gap-3">
                    <select name="SelectedLanguageCode" 
                            class="flex-1 px-4 py-3 border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition">
                        <option value="">-- Select a Language --</option>
                        @foreach (var lang in Model.AvailableLanguages)
                        {
                            <option value="@lang.LanguageCode">@lang.LanguageName</option>
                        }
                    </select>
                    <button type="submit" 
                            class="px-6 py-3 bg-indigo-600 text-white font-semibold rounded-lg hover:bg-indigo-700 transition duration-200 whitespace-nowrap">
                        Add Language
                    </button>
                </form>
            </div>
        }

        <!-- Current Languages Section -->
        <div>
            <h2 class="text-xl font-bold text-slate-900 mb-8 flex items-center gap-2">
                <span class="text-2xl">📚</span> Your Languages
            </h2>

            @if (Model.UserLanguages.Count == 0)
            {
                <div class="bg-white rounded-lg border border-slate-200 p-12 text-center">
                    <p class="text-slate-500 text-lg mb-4">No languages added yet</p>
                    <a href="/Account/ManageLanguages" class="px-6 py-2 bg-indigo-600 text-white font-semibold rounded-lg hover:bg-indigo-700 transition inline-block">
                        Add Your First Language
                    </a>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    @foreach (var lang in Model.UserLanguages)
                    {
                        <div class="bg-white rounded-lg border border-slate-200 overflow-hidden hover:border-slate-300 transition">
                            <!-- Language Header -->
                            <div class="bg-gradient-to-r from-slate-100 to-slate-50 px-6 py-6 border-b border-slate-200">
                                <div class="flex items-start justify-between mb-3">
                                    <div class="flex items-center gap-3">
                                        <div class="text-5xl">
                                            @if (lang.LanguageCode == "de")
                                            {
                                                <span>🇩🇪</span>
                                            }
                                            else if (lang.LanguageCode == "fr")
                                            {
                                                <span>🇫🇷</span>
                                            }
                                            else if (lang.LanguageCode == "es")
                                            {
                                                <span>🇪🇸</span>
                                            }
                                            else if (lang.LanguageCode == "ru")
                                            {
                                                <span>🇷🇺</span>
                                            }
                                        </div>
                                        <div>
                                            <h3 class="text-xl font-bold text-slate-900">@lang.LanguageName</h3>
                                            <p class="text-xs text-slate-500">Code: @lang.LanguageCode</p>
                                        </div>
                                    </div>
                                    @if (lang.IsActive)
                                    {
                                        <span class="px-3 py-1 bg-emerald-100 text-emerald-700 text-xs font-bold rounded-full">🟢 Active</span>
                                    }
                                </div>
                            </div>

                            <!-- Statistics -->
                            <div class="p-6 space-y-5">
                                <!-- Items Count -->
                                <div>
                                    <div class="flex justify-between items-center mb-2">
                                        <p class="text-sm font-semibold text-slate-700">Items Learned</p>
                                        <p class="text-lg font-bold text-indigo-600">@lang.ItemCount</p>
                                    </div>
                                    <div class="w-full bg-slate-200 rounded-full h-2">
                                        <div class="bg-gradient-to-r from-blue-500 to-cyan-500 h-2 rounded-full transition-all duration-300" 
                                             style="width: @(Math.Min(lang.ItemCount * 10, 100))%"></div>
                                    </div>
                                </div>

                                <!-- Mastery Level -->
                                <div>
                                    <div class="flex justify-between items-center mb-2">
                                        <p class="text-sm font-semibold text-slate-700">Mastery Level</p>
                                        <div class="flex items-center gap-1">
                                            @if (lang.MasteryLevel >= 80)
                                            {
                                                <span class="text-lg">🏆</span>
                                            }
                                            else if (lang.MasteryLevel >= 60)
                                            {
                                                <span class="text-lg">🎯</span>
                                            }
                                            else if (lang.MasteryLevel >= 40)
                                            {
                                                <span class="text-lg">📈</span>
                                            }
                                            <p class="text-lg font-bold text-slate-900">@lang.MasteryLevel%</p>
                                        </div>
                                    </div>
                                    <div class="w-full bg-slate-200 rounded-full h-3">
                                        <div class="bg-gradient-to-r from-yellow-500 to-orange-500 h-3 rounded-full transition-all duration-300" 
                                             style="width: @lang.MasteryLevel%"></div>
                                    </div>
                                </div>

                                <!-- Action Button -->
                                <a href="/Index?SelectedLanguage=@lang.LanguageCode"
                                   class="block w-full px-4 py-2 bg-indigo-100 text-indigo-700 font-semibold rounded-lg hover:bg-indigo-200 transition text-center text-sm">
                                    Continue Learning →
                                </a>

                                <!-- Remove Button -->
                                @if (Model.UserLanguages.Count > 1)
                                {
                                    <form method="post" asp-page-handler="RemoveLanguage" class="w-full">
                                        <input type="hidden" name="languageProfileId" value="@lang.LanguageProfileId" />
                                        <button type="submit" 
                                                class="w-full px-4 py-2 text-red-600 font-semibold text-sm border border-red-300 rounded-lg hover:bg-red-50 transition"
                                                onclick="return confirm('Are you sure? This will delete all data for this language.')">
                                            🗑️ Remove
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button disabled
                                            class="w-full px-4 py-2 text-slate-400 font-semibold text-sm bg-slate-100 rounded-lg cursor-not-allowed">
                                        🔒 Cannot Remove (Only Language)
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Bottom Navigation -->
        <div class="flex gap-4 pt-12 mt-12 border-t border-slate-200">
            <a href="/Account/Profile" 
               class="flex-1 px-6 py-3 border border-slate-300 text-slate-700 font-semibold rounded-lg hover:bg-slate-50 transition duration-200 text-center">
                👤 Back to Profile
            </a>
            <a href="/Index" 
               class="flex-1 px-6 py-3 bg-indigo-600 text-white font-semibold rounded-lg hover:bg-indigo-700 transition duration-200 text-center">
                📚 Go to Learning
            </a>
        </div>
    </div>
</div>
