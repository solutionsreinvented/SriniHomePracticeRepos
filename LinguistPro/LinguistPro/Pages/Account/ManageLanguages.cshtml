@page
@model LinguistPro.Pages.Account.ManageLanguagesModel
@{
    ViewData["Title"] = "Manage Languages";
    Layout = "_Layout";
}

<div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
        <div class="bg-white rounded-lg shadow-lg overflow-hidden">
            <!-- Header -->
            <div class="bg-gradient-to-r from-indigo-600 to-purple-600 px-6 py-8">
                <h1 class="text-3xl font-bold text-white">🌐 Manage Languages</h1>
                <p class="text-indigo-100 mt-1">Add or remove language profiles</p>
            </div>

            <!-- Content -->
            <div class="p-8">
                <!-- Success Message -->
                @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                {
                    <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg">
                        <p class="text-green-800 font-semibold">@Model.SuccessMessage</p>
                    </div>
                }

                <!-- Error Message -->
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
                        <p class="text-red-800 font-semibold">@Model.ErrorMessage</p>
                    </div>
                }

                <!-- Add New Language Section -->
                @if (Model.AvailableLanguages.Count > 0)
                {
                    <div class="mb-8 pb-8 border-b">
                        <h2 class="text-2xl font-bold text-gray-900 mb-4">➕ Add Language</h2>
                        <form method="post" asp-page-handler="AddLanguage" class="flex gap-4">
                            <select name="SelectedLanguageCode" 
                                    class="flex-1 px-4 py-3 border-2 border-gray-200 rounded-lg focus:outline-none focus:border-indigo-500 transition">
                                <option value="">-- Select a Language --</option>
                                @foreach (var lang in Model.AvailableLanguages)
                                {
                                    <option value="@lang.LanguageCode">@lang.LanguageName</option>
                                }
                            </select>
                            <button type="submit" 
                                    class="px-6 py-3 bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-semibold rounded-lg hover:from-indigo-700 hover:to-purple-700 transition">
                                Add Language
                            </button>
                        </form>
                    </div>
                }

                <!-- Current Languages Section -->
                <div>
                    <h2 class="text-2xl font-bold text-gray-900 mb-4">📚 Your Languages</h2>
                    
                    @if (Model.UserLanguages.Count == 0)
                    {
                        <div class="text-center py-12">
                            <p class="text-gray-500 text-lg">No languages added yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            @foreach (var lang in Model.UserLanguages)
                            {
                                <div class="border-2 border-gray-200 rounded-lg p-6 hover:border-indigo-400 transition">
                                    <!-- Language Name and Code -->
                                    <div class="flex items-start justify-between mb-4">
                                        <div>
                                            <h3 class="text-xl font-bold text-gray-900">
                                                @if (lang.LanguageCode == "de")
                                                {
                                                    <span>🇩🇪</span>
                                                }
                                                else if (lang.LanguageCode == "fr")
                                                {
                                                    <span>🇫🇷</span>
                                                }
                                                else if (lang.LanguageCode == "es")
                                                {
                                                    <span>🇪🇸</span>
                                                }
                                                else if (lang.LanguageCode == "ru")
                                                {
                                                    <span>🇷🇺</span>
                                                }
                                                @lang.LanguageName
                                            </h3>
                                            <p class="text-sm text-gray-500 mt-1">Code: @lang.LanguageCode</p>
                                        </div>
                                        @if (lang.IsActive)
                                        {
                                            <span class="inline-block px-3 py-1 bg-green-100 text-green-800 text-xs font-semibold rounded-full">Active</span>
                                        }
                                    </div>

                                    <!-- Stats -->
                                    <div class="grid grid-cols-2 gap-4 mb-6 py-4 border-y border-gray-200">
                                        <div>
                                            <p class="text-xs text-gray-500">Items Learned</p>
                                            <p class="text-2xl font-bold text-indigo-600">@lang.ItemCount</p>
                                        </div>
                                        <div>
                                            <p class="text-xs text-gray-500">Mastery Level</p>
                                            <div class="mt-2">
                                                <div class="w-full bg-gray-200 rounded-full h-2">
                                                    <div class="bg-gradient-to-r from-indigo-600 to-purple-600 h-2 rounded-full" 
                                                         style="width: @((lang.MasteryLevel * 10))%"></div>
                                                </div>
                                                <p class="text-sm font-semibold text-gray-700 mt-1">@lang.MasteryLevel%</p>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Remove Button -->
                                    @if (Model.UserLanguages.Count > 1)
                                    {
                                        <form method="post" asp-page-handler="RemoveLanguage" class="inline">
                                            <input type="hidden" name="languageProfileId" value="@lang.LanguageProfileId" />
                                            <button type="submit" 
                                                    class="w-full px-4 py-2 text-red-600 font-semibold hover:bg-red-50 rounded-lg border border-red-300 transition"
                                                    onclick="return confirm('Are you sure? This will delete all data for this language.')">
                                                🗑️ Remove Language
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button disabled
                                                class="w-full px-4 py-2 text-gray-400 font-semibold bg-gray-100 rounded-lg cursor-not-allowed">
                                            🗑️ Cannot Remove (Only Language)
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Navigation Buttons -->
                <div class="flex gap-4 pt-8 mt-8 border-t">
                    <a href="/Account/Profile" 
                       class="flex-1 px-6 py-3 bg-gray-200 text-gray-800 font-semibold rounded-lg hover:bg-gray-300 transition text-center">
                        👤 Back to Profile
                    </a>
                    <a href="/Index" 
                       class="flex-1 px-6 py-3 bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-semibold rounded-lg hover:from-indigo-700 hover:to-purple-700 transition text-center">
                        📚 Go to Learning
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
