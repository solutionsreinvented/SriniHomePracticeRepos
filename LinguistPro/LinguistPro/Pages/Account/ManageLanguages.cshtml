@page
@model LinguistPro.Pages.Account.ManageLanguagesModel
@{
    ViewData["Title"] = "Manage Languages";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/account-pages.css">
<link rel="stylesheet" href="~/css/dashboard.css">
<link rel="stylesheet" href="~/css/custom-dropdown.css">

<div class="account-header">
    <div class="account-header-content">
        <nav class="account-nav">
            <a href="/Dashboard">Dashboard</a>
            <a href="/Account/Profile">Profile</a>
            <a href="/Account/ManageLanguages" class="active">Manage Languages</a>
        </nav>
    </div>
</div>

<!-- Top Section with Back Link -->
<div class="account-top-section">
    <a href="/Account/Profile" class="back-link">← Back to Profile</a>
</div>

<div class="account-container">
    <div class="account-main">
        <!-- Page Header -->
        <div class="account-page-header">
            <h1 class="account-page-title">🌐 Manage Languages</h1>
            <p class="account-page-subtitle">Add, remove, and manage your language learning profiles</p>
        </div>

        <!-- Success Message -->
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success">
                <span class="alert-icon">✓</span>
                <div>@Model.SuccessMessage</div>
            </div>
        }

        <!-- Error Message -->
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-error">
                <span class="alert-icon">✗</span>
                <div>@Model.ErrorMessage</div>
            </div>
        }

        <!-- Add Language Form -->
        @if (Model.AvailableLanguages.Count > 0)
        {
            <div class="account-card">
                <div class="card-header">
                    <span class="card-header-icon">➕</span>
                    <h2 class="card-title">Add New Language</h2>
                </div>
                <form method="post" asp-page-handler="AddLanguage" class="form-row form-row-2col">
                    <div class="form-group">
                        <label class="form-label required">Select Language</label>
                        <div class="custom-select-wrapper">
                            <select name="SelectedLanguageCode" class="custom-select" onchange="this.form.submit()">
                                <option value="">-- Select a Language --</option>
                                @foreach (var lang in Model.AvailableLanguages)
                                {
                                    var icon = GetLanguageIcon(lang.LanguageCode);
                                    <option value="@lang.LanguageCode" data-icon="@icon">@lang.LanguageName</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-group" style="display: flex; align-items: flex-end;">
                        <button type="submit" class="btn btn-primary">
                            <span>➕</span> Add Language
                        </button>
                    </div>
                </form>
            </div>
        }

        <!-- Your Languages Section -->
        @if (Model.UserLanguages.Count == 0)
        {
            <div class="account-card" style="text-align: center; padding: 60px 40px;">
                <p style="font-size: 40px; margin-bottom: 20px;">📚</p>
                <p style="font-size: 18px; font-weight: 600; color: #1a1a1a; margin-bottom: 20px;">No languages added yet</p>
                <p style="font-size: 14px; color: #666; margin-bottom: 32px;">Start your language learning journey by adding your first language</p>
            </div>
        }
        else
        {
            <div class="account-main">
                <h2 style="font-size: 24px; font-weight: 700; color: #1a1a1a; margin-bottom: 28px; display: flex; align-items: center; gap: 12px;">
                    <span>📖</span> Your Languages
                </h2>
                <div class="language-list">
                    @foreach (var lang in Model.UserLanguages)
                    {
                        <div class="language-item">
                            <!-- Flag -->
                            <span class="language-flag">
                                @GetLanguageIcon(lang.LanguageCode)
                            </span>

                            <!-- Language Info -->
                            <div class="language-info">
                                <div class="language-name">@lang.LanguageName</div>
                                <div class="language-stats">
                                    <div class="language-stat-item">
                                        <span class="language-stat-icon">📚</span>
                                        <span>@lang.ItemCount items</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Mastery Level -->
                            <div class="language-mastery">
                                <div class="language-mastery-value">@lang.MasteryLevel%</div>
                                <div class="language-mastery-label">Mastery</div>
                            </div>

                            <!-- Remove Button -->
                            @if (Model.UserLanguages.Count > 1)
                            {
                                <form method="post" asp-page-handler="RemoveLanguage" class="inline-block">
                                    <input type="hidden" name="languageProfileId" value="@lang.LanguageProfileId" />
                                    <button type="submit" 
                                            class="btn btn-danger"
                                            onclick="return confirm('Delete all data for this language?')">
                                        <span>🗑️</span> Remove
                                    </button>
                                </form>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@functions {
    private string GetLanguageIcon(string languageCode)
    {
        return languageCode switch
        {
            "de" => "🇩🇪",
            "fr" => "🇫🇷",
            "es" => "🇪🇸",
            "ru" => "🇷🇺",
            "ko" => "🇰🇷",
            _ => "🌍"
        };
    }
}

@section Scripts {
    <script src="~/js/custom-dropdown.js"></script>
    <script>
        // Force initialization after a short delay to ensure DOM is ready
        setTimeout(function() {
            console.log('[CustomDropdown] Force initializing...');
            const selects = document.querySelectorAll('select.custom-select');
            console.log('[CustomDropdown] Found selects:', selects.length);

            selects.forEach(select => {
                if (!select.dataset.customDropdownInit) {
                    console.log('[CustomDropdown] Creating dropdown for:', select.name);
                    new CustomDropdown(select);
                    select.dataset.customDropdownInit = '1';
                } else {
                    console.log('[CustomDropdown] Already initialized:', select.name);
                }
            });
        }, 100);
    </script>
}
