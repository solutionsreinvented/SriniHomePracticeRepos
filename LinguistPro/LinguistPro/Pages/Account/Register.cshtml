@page
@model LinguistPro.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LinguistPro</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-slate-50 to-slate-100 min-h-screen flex items-center justify-center">
    <div class="w-full max-w-md px-6">
        <!-- Logo/Header -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-indigo-600 to-purple-600 rounded-full mb-4">
                <span style="font-size: 32px;">🌍</span>
            </div>
            <h1 class="text-3xl font-bold text-gray-900">Linguist Pro</h1>
            <p class="text-gray-600 mt-2">Master Languages, One Lesson at a Time</p>
        </div>

        <!-- Registration Card -->
        <div class="bg-white rounded-lg shadow-lg p-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Create Account</h2>

            <form method="post" asp-page="./Register" class="space-y-4">
                <!-- First Name -->
                <div>
                    <label asp-for="Input.FirstName" class="block text-sm font-medium text-gray-700 mb-2">First Name</label>
                    <input asp-for="Input.FirstName" 
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition" 
                           placeholder="John" 
                           required />
                    <span asp-validation-for="Input.FirstName" class="text-red-600 text-sm mt-1"></span>
                </div>

                <!-- Last Name -->
                <div>
                    <label asp-for="Input.LastName" class="block text-sm font-medium text-gray-700 mb-2">Last Name</label>
                    <input asp-for="Input.LastName" 
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition" 
                           placeholder="Doe" 
                           required />
                    <span asp-validation-for="Input.LastName" class="text-red-600 text-sm mt-1"></span>
                </div>

                <!-- Email -->
                <div>
                    <label asp-for="Input.Email" class="block text-sm font-medium text-gray-700 mb-2">Email Address</label>
                    <input asp-for="Input.Email" 
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition" 
                           placeholder="your@email.com" 
                           required />
                    <span asp-validation-for="Input.Email" class="text-red-600 text-sm mt-1"></span>
                </div>

                <!-- Date of Birth -->
                <div>
                    <label asp-for="Input.DateOfBirth" class="block text-sm font-medium text-gray-700 mb-2">Date of Birth (Optional)</label>
                    <input asp-for="Input.DateOfBirth" 
                           type="date"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition" />
                    <span asp-validation-for="Input.DateOfBirth" class="text-red-600 text-sm mt-1"></span>
                </div>

                <!-- Country -->
                <div>
                    <label asp-for="Input.Country" class="block text-sm font-medium text-gray-700 mb-2">Country (Optional)</label>
                    <input asp-for="Input.Country" 
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition" 
                           placeholder="United States" />
                    <span asp-validation-for="Input.Country" class="text-red-600 text-sm mt-1"></span>
                </div>

                <!-- Password -->
                <div>
                    <label asp-for="Input.Password" class="block text-sm font-medium text-gray-700 mb-2">Password</label>
                    <input asp-for="Input.Password" 
                           type="password"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition" 
                           placeholder="••••••••" 
                           required />
                    <span asp-validation-for="Input.Password" class="text-red-600 text-sm mt-1"></span>
                    <p class="text-xs text-gray-500 mt-1">Minimum 6 characters, at least one uppercase and one digit</p>
                </div>

                <!-- Confirm Password -->
                <div>
                    <label asp-for="Input.ConfirmPassword" class="block text-sm font-medium text-gray-700 mb-2">Confirm Password</label>
                    <input asp-for="Input.ConfirmPassword" 
                           type="password"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition" 
                           placeholder="••••••••" 
                           required />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-red-600 text-sm mt-1"></span>
                </div>

                <!-- Error Messages -->
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
                {
                    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
                        <p class="text-red-800 text-sm">
                            <strong>Registration Failed:</strong>
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </p>
                    </div>
                }

                <!-- Register Button -->
                <button type="submit" class="w-full bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white font-semibold py-2 px-4 rounded-lg transition duration-200 mt-6">
                    Create Account
                </button>
            </form>

            <!-- Divider -->
            <div class="my-6 flex items-center">
                <div class="flex-1 border-t border-gray-300"></div>
                <span class="px-4 text-gray-500 text-sm">Already have an account?</span>
                <div class="flex-1 border-t border-gray-300"></div>
            </div>

            <!-- Sign In Link -->
            <a href="/Account/Login" class="w-full block text-center bg-gray-100 hover:bg-gray-200 text-gray-900 font-semibold py-2 px-4 rounded-lg transition duration-200">
                Sign In
            </a>
        </div>

        <!-- Footer -->
        <p class="text-center text-gray-600 text-sm mt-6">
            By registering, you agree to our <a href="#" class="text-indigo-600 hover:underline">Terms of Service</a> and <a href="#" class="text-indigo-600 hover:underline">Privacy Policy</a>
        </p>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
