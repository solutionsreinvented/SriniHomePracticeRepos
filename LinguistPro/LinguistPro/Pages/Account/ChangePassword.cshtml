@page
@model LinguistPro.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
    Layout = "_Layout";
}

<div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100">
    <!-- Header -->
    <div class="bg-white border-b border-slate-200">
        <div class="max-w-3xl mx-auto px-6 py-6 flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-bold text-slate-900">Change Password</h1>
                <p class="text-slate-500 mt-1">Update your account security</p>
            </div>
            <a href="/Account/Profile" class="px-4 py-2 text-slate-600 hover:text-slate-900 font-medium transition">← Back</a>
        </div>
    </div>

    <div class="max-w-3xl mx-auto px-6 py-12">
        <!-- Success Message -->
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="mb-8 p-4 bg-emerald-50 border border-emerald-200 rounded-lg flex items-start gap-3">
                <span class="text-2xl mt-1">✓</span>
                <div>
                    <p class="text-emerald-900 font-semibold">Success</p>
                    <p class="text-emerald-700 text-sm">@Model.SuccessMessage</p>
                </div>
            </div>
        }

        <!-- Error Message -->
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="mb-8 p-4 bg-red-50 border border-red-200 rounded-lg flex items-start gap-3">
                <span class="text-2xl mt-1">✗</span>
                <div>
                    <p class="text-red-900 font-semibold">Error</p>
                    <p class="text-red-700 text-sm">@Model.ErrorMessage</p>
                </div>
            </div>
        }

        <!-- Security Info Alert -->
        <div class="mb-8 p-4 bg-cyan-50 border border-cyan-200 rounded-lg flex items-start gap-3">
            <span class="text-2xl mt-1">🛡️</span>
            <div>
                <p class="text-cyan-900 font-semibold">Security Tip</p>
                <p class="text-cyan-700 text-sm">Use a strong password with uppercase, lowercase, numbers, and special characters.</p>
            </div>
        </div>

        <!-- Main Form Card -->
        <div class="bg-white rounded-lg border border-slate-200 p-8">
            <form method="post" class="space-y-6">
                <!-- Current Password -->
                <div>
                    <label class="block text-sm font-semibold text-slate-900 mb-2">
                        Current Password <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="CurrentPassword" type="password"
                           class="w-full px-4 py-3 border border-slate-300 rounded-lg text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition"
                           placeholder="Enter your current password"
                           required />
                    <span asp-validation-for="CurrentPassword" class="text-red-600 text-xs mt-1 block" style="display: block;"></span>
                </div>

                <!-- Divider -->
                <div class="border-t border-slate-200 my-2"></div>

                <!-- New Password -->
                <div>
                    <label class="block text-sm font-semibold text-slate-900 mb-2">
                        New Password <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="NewPassword" type="password"
                           class="w-full px-4 py-3 border border-slate-300 rounded-lg text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent transition"
                           placeholder="Enter your new password"
                           required />
                    <p class="text-xs text-slate-500 mt-2">Minimum 6 characters</p>
                    <span asp-validation-for="NewPassword" class="text-red-600 text-xs mt-1 block" style="display: block;"></span>
                </div>

                <!-- Confirm Password -->
                <div>
                    <label class="block text-sm font-semibold text-slate-900 mb-2">
                        Confirm Password <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="ConfirmPassword" type="password"
                           class="w-full px-4 py-3 border border-slate-300 rounded-lg text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent transition"
                           placeholder="Re-enter your new password"
                           required />
                    <span asp-validation-for="ConfirmPassword" class="text-red-600 text-xs mt-1 block" style="display: block;"></span>
                </div>

                <!-- Action Buttons -->
                <div class="flex gap-4 pt-6 border-t border-slate-200">
                    <button type="submit" 
                            class="flex-1 px-6 py-3 bg-indigo-600 text-white font-semibold rounded-lg hover:bg-indigo-700 transition duration-200 flex items-center justify-center gap-2">
                        <span class="text-lg">🔄</span> Update Password
                    </button>
                    <a href="/Account/Profile" 
                       class="flex-1 px-6 py-3 border border-slate-300 text-slate-700 font-semibold rounded-lg hover:bg-slate-50 transition duration-200 text-center">
                        Cancel
                    </a>
                </div>
            </form>
        </div>

        <!-- Password Requirements Card -->
        <div class="mt-8 bg-white rounded-lg border border-slate-200 p-6">
            <h3 class="font-bold text-slate-900 mb-4 flex items-center gap-2">
                <span class="text-lg">📋</span> Password Requirements
            </h3>
            <ul class="space-y-3">
                <li class="flex items-center gap-3 text-slate-600 text-sm">
                    <span class="w-2 h-2 bg-green-500 rounded-full"></span>
                    Minimum 6 characters
                </li>
                <li class="flex items-center gap-3 text-slate-600 text-sm">
                    <span class="w-2 h-2 bg-green-500 rounded-full"></span>
                    Mix of uppercase and lowercase letters
                </li>
                <li class="flex items-center gap-3 text-slate-600 text-sm">
                    <span class="w-2 h-2 bg-green-500 rounded-full"></span>
                    Include numbers (0-9)
                </li>
                <li class="flex items-center gap-3 text-slate-600 text-sm">
                    <span class="w-2 h-2 bg-green-500 rounded-full"></span>
                    Include special characters (symbols)
                </li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
