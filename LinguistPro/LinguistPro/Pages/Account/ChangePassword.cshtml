@page
@model LinguistPro.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/account-pages.css">

<div class="account-container">
    <a href="/Account/Profile" class="back-link">← Back</a>

    <div class="account-main">
        <div class="account-page-header">
            <h1 class="account-page-title">Change Password</h1>
            <p class="account-page-subtitle">Update your account security</p>
        </div>

        <!-- Success Message -->
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success">
                <span class="alert-icon">✓</span>
                <div>@Model.SuccessMessage</div>
            </div>
        }

        <!-- Error Message -->
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-error">
                <span class="alert-icon">✗</span>
                <div>@Model.ErrorMessage</div>
            </div>
        }

        <!-- Security Info Alert -->
        <div class="alert alert-info">
            <span class="alert-icon">🛡️</span>
            <div>Use a strong password with uppercase, lowercase, numbers, and special characters.</div>
        </div>

        <!-- Change Password Form -->
        <div class="account-card">
            <div class="card-header">
                <span class="card-header-icon">🔐</span>
                <h2 class="card-title">Change Password</h2>
            </div>

            <form method="post">
                <!-- Current Password -->
                <div class="form-group">
                    <label class="form-label required">Current Password</label>
                    <input asp-for="CurrentPassword" type="password" class="form-input" placeholder="Enter current password" required>
                    <span asp-validation-for="CurrentPassword" class="form-error" style="display: block;"></span>
                </div>

                <hr style="margin: 24px 0; border: none; border-top: 1px solid #f0f0f0;">

                <!-- New Password -->
                <div class="form-group">
                    <label class="form-label required">New Password</label>
                    <input asp-for="NewPassword" type="password" class="form-input" placeholder="Enter new password" required>
                    <div class="form-help">Minimum 6 characters</div>
                    <span asp-validation-for="NewPassword" class="form-error" style="display: block;"></span>
                </div>

                <!-- Confirm Password -->
                <div class="form-group">
                    <label class="form-label required">Confirm Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-input" placeholder="Re-enter password" required>
                    <span asp-validation-for="ConfirmPassword" class="form-error" style="display: block;"></span>
                </div>

                <div class="button-group">
                    <button type="submit" class="btn btn-primary">
                        <span>🔄</span> Update Password
                    </button>
                    <a href="/Account/Profile" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>

        <!-- Password Requirements Card -->
        <div class="account-card">
            <h2 class="card-title" style="margin-bottom: 16px; display: flex; align-items: center; gap: 8px;">
                <span>📋</span> Password Requirements
            </h2>
            <ul style="list-style: none; padding: 0;">
                <li style="padding: 8px 0; display: flex; gap: 8px; align-items: flex-start; color: #666; font-size: 14px;">
                    <span style="color: #16a34a; margin-top: 2px;">●</span>
                    <span>Minimum 6 characters</span>
                </li>
                <li style="padding: 8px 0; display: flex; gap: 8px; align-items: flex-start; color: #666; font-size: 14px;">
                    <span style="color: #16a34a; margin-top: 2px;">●</span>
                    <span>Mix of uppercase and lowercase letters</span>
                </li>
                <li style="padding: 8px 0; display: flex; gap: 8px; align-items: flex-start; color: #666; font-size: 14px;">
                    <span style="color: #16a34a; margin-top: 2px;">●</span>
                    <span>Include numbers (0-9)</span>
                </li>
                <li style="padding: 8px 0; display: flex; gap: 8px; align-items: flex-start; color: #666; font-size: 14px;">
                    <span style="color: #16a34a; margin-top: 2px;">●</span>
                    <span>Include special characters and symbols</span>
                </li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
