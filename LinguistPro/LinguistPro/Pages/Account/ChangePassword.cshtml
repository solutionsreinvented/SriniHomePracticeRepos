@page
@model LinguistPro.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/account-pages.css">

<div class="account-header">
    <div class="account-header-content">
        <nav class="account-nav">
            <a href="/Dashboard">Dashboard</a>
            <a href="/Account/Profile">Profile</a>
            <a href="/Account/ChangePassword" class="active">Change Password</a>
        </nav>
    </div>
</div>

<!-- Top Section with Back Link -->
<div class="account-top-section">
    <a href="/Account/Profile" class="back-link">← Back to Profile</a>
</div>

<div class="account-container">
    <div class="account-main">
        <!-- Page Header -->
        <div class="account-page-header">
            <h1 class="account-page-title">🔐 Change Password</h1>
            <p class="account-page-subtitle">Update and secure your account with a strong password</p>
        </div>

        <!-- Success Message -->
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success">
                <span class="alert-icon">✓</span>
                <div>@Model.SuccessMessage</div>
            </div>
        }

        <!-- Error Message -->
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-error">
                <span class="alert-icon">✗</span>
                <div>@Model.ErrorMessage</div>
            </div>
        }

        <!-- Security Info Alert -->
        <div class="alert alert-info">
            <span class="alert-icon">🛡️</span>
            <div><strong>Security Tip:</strong> Use a combination of uppercase, lowercase, numbers, and special characters for maximum security.</div>
        </div>

        <!-- Change Password Form -->
        <div class="account-card">
            <form method="post">
                <!-- Current Password -->
                <div class="form-group">
                    <label class="form-label required">Current Password</label>
                    <input asp-for="CurrentPassword" type="password" class="form-input" placeholder="Enter your current password" required>
                    <span asp-validation-for="CurrentPassword" class="form-error" style="display: block;"></span>
                </div>

                <!-- Divider -->
                <hr style="margin: 32px 0; border: none; border-top: 1px solid #f0f0f0;">

                <!-- New Password -->
                <div class="form-group">
                    <label class="form-label required">New Password</label>
                    <input asp-for="NewPassword" type="password" class="form-input" placeholder="Enter your new password" required>
                    <div class="form-help">Minimum 6 characters required</div>
                    <span asp-validation-for="NewPassword" class="form-error" style="display: block;"></span>
                </div>

                <!-- Confirm Password -->
                <div class="form-group">
                    <label class="form-label required">Confirm Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-input" placeholder="Re-enter your new password" required>
                    <span asp-validation-for="ConfirmPassword" class="form-error" style="display: block;"></span>
                </div>

                <!-- Buttons -->
                <div class="button-group">
                    <button type="submit" class="btn btn-primary">
                        <span>🔄</span> Update Password
                    </button>
                    <a href="/Account/Profile" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>

        <!-- Password Requirements Card -->
        <div class="account-card">
            <h2 class="card-title" style="margin-bottom: 24px; display: flex; align-items: center; gap: 12px;">
                <span>📋</span> Password Requirements
            </h2>
            <ul style="list-style: none; padding: 0; space-y: 12px;">
                <li style="padding: 12px 0; display: flex; gap: 12px; align-items: flex-start; color: #666; font-size: 14px; border-bottom: 1px solid #f0f0f0;">
                    <span style="color: #16a34a; font-weight: 700; font-size: 18px; margin-top: -4px;">✓</span>
                    <span>Minimum 6 characters in length</span>
                </li>
                <li style="padding: 12px 0; display: flex; gap: 12px; align-items: flex-start; color: #666; font-size: 14px; border-bottom: 1px solid #f0f0f0;">
                    <span style="color: #16a34a; font-weight: 700; font-size: 18px; margin-top: -4px;">✓</span>
                    <span>Mix of uppercase (A-Z) and lowercase (a-z) letters</span>
                </li>
                <li style="padding: 12px 0; display: flex; gap: 12px; align-items: flex-start; color: #666; font-size: 14px; border-bottom: 1px solid #f0f0f0;">
                    <span style="color: #16a34a; font-weight: 700; font-size: 18px; margin-top: -4px;">✓</span>
                    <span>Include at least one number (0-9)</span>
                </li>
                <li style="padding: 12px 0; display: flex; gap: 12px; align-items: flex-start; color: #666; font-size: 14px;">
                    <span style="color: #16a34a; font-weight: 700; font-size: 18px; margin-top: -4px;">✓</span>
                    <span>Include at least one special character (!@@#$%^&*)</span>
                </li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
