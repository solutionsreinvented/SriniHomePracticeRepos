@page
@model LinguistPro.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "User Profile";
    Layout = "_Layout";
}

<div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
        <div class="bg-white rounded-lg shadow-lg overflow-hidden">
            <!-- Header -->
            <div class="bg-gradient-to-r from-indigo-600 to-purple-600 px-6 py-8">
                <h1 class="text-3xl font-bold text-white">👤 User Profile</h1>
                <p class="text-indigo-100 mt-1">Manage your personal information</p>
            </div>

            <!-- Content -->
            <div class="p-8">
                <!-- Success Message -->
                @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                {
                    <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg">
                        <p class="text-green-800 font-semibold">✓ @Model.SuccessMessage</p>
                    </div>
                }

                <!-- Error Message -->
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
                        <p class="text-red-800 font-semibold">✗ @Model.ErrorMessage</p>
                    </div>
                }

                <!-- Email (Read-only) -->
                <div class="mb-8 pb-8 border-b">
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Email Address</label>
                    <input type="email" value="@Model.CurrentUserEmail" disabled 
                           class="w-full px-4 py-3 bg-gray-100 border-2 border-gray-200 rounded-lg text-gray-600 cursor-not-allowed" />
                    <p class="text-sm text-gray-500 mt-2">Your email address cannot be changed here</p>
                </div>

                <!-- Profile Form -->
                <form method="post" class="space-y-6">
                    <!-- First Name -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">First Name *</label>
                        <input asp-for="FirstName" 
                               class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:outline-none focus:border-indigo-500 transition"
                               placeholder="Enter your first name"
                               required />
                    </div>

                    <!-- Last Name -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Last Name *</label>
                        <input asp-for="LastName" 
                               class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:outline-none focus:border-indigo-500 transition"
                               placeholder="Enter your last name"
                               required />
                    </div>

                    <!-- Date of Birth -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Date of Birth</label>
                        <input asp-for="DateOfBirth" type="date"
                               class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:outline-none focus:border-indigo-500 transition" />
                    </div>

                    <!-- Country -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Country</label>
                        <input asp-for="Country" 
                               class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:outline-none focus:border-indigo-500 transition"
                               placeholder="Enter your country" />
                    </div>

                    <!-- Buttons -->
                    <div class="flex gap-4 pt-6">
                        <button type="submit" 
                                class="flex-1 px-6 py-3 bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-semibold rounded-lg hover:from-indigo-700 hover:to-purple-700 transition">
                            💾 Save Changes
                        </button>
                        <a href="/Index" 
                           class="flex-1 px-6 py-3 bg-gray-200 text-gray-800 font-semibold rounded-lg hover:bg-gray-300 transition text-center">
                            ← Back
                        </a>
                    </div>
                </form>
            </div>

            <!-- Footer Info -->
            <div class="bg-gray-50 px-8 py-6 border-t">
                <p class="text-sm text-gray-600">
                    Need to change your password? <a href="/Account/ChangePassword" class="text-indigo-600 hover:underline font-semibold">Click here</a>
                </p>
            </div>
        </div>
    </div>
</div>
