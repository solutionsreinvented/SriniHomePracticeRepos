@page
@model LinguistPro.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "User Profile";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/account-pages.css">

<div class="account-container">
    <a href="/Index" class="back-link">← Back</a>

    <div class="account-main">
        <div class="account-page-header">
            <h1 class="account-page-title">User Profile</h1>
            <p class="account-page-subtitle">Manage your personal information</p>
        </div>

        <!-- Success Message -->
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success">
                <span class="alert-icon">✓</span>
                <div>@Model.SuccessMessage</div>
            </div>
        }

        <!-- Error Message -->
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-error">
                <span class="alert-icon">✗</span>
                <div>@Model.ErrorMessage</div>
            </div>
        }

        <!-- Account Card -->
        <div class="account-card">
            <div class="card-header">
                <span class="card-header-icon">🔐</span>
                <h2 class="card-title">Account</h2>
            </div>

            <div class="form-group">
                <label class="form-label">Email Address</label>
                <input type="email" value="@Model.CurrentUserEmail" disabled class="form-input" style="background: #f5f5f5; cursor: not-allowed;">
                <div class="form-help">Cannot be changed</div>
            </div>
        </div>

        <!-- Other Settings Card -->
        <div class="account-card">
            <h2 class="card-title" style="margin-bottom: 16px;">Other Settings</h2>
            <div style="display: flex; gap: 24px; flex-wrap: wrap;">
                <a href="/Account/ChangePassword" class="sidebar-link" style="color: #2563eb; font-weight: 500;">
                    🔐 Change Password
                </a>
                <a href="/Account/ManageLanguages" class="sidebar-link" style="color: #2563eb; font-weight: 500;">
                    🌐 Manage Languages
                </a>
            </div>
        </div>

        <!-- Personal Information Card -->
        <div class="account-card">
            <div class="card-header">
                <span class="card-header-icon">✏️</span>
                <h2 class="card-title">Personal Information</h2>
            </div>

            <form method="post">
                <div class="form-row form-row-3col">
                    <div>
                        <label class="form-label required">First Name</label>
                        <input asp-for="FirstName" class="form-input" placeholder="Enter first name" required>
                    </div>
                    <div style="grid-column: span 1;">
                        <label class="form-label required">Last Name</label>
                        <input asp-for="LastName" class="form-input" placeholder="Enter last name" required>
                    </div>
                </div>

                <div class="form-row form-row-3col">
                    <div>
                        <label class="form-label">Date of Birth</label>
                        <input asp-for="DateOfBirth" type="date" class="form-input">
                        <div class="form-help">Optional</div>
                    </div>
                    <div style="grid-column: span 1;">
                        <label class="form-label">Country</label>
                        <input asp-for="Country" class="form-input" placeholder="e.g., India, United States">
                        <div class="form-help">Optional</div>
                    </div>
                </div>

                <div class="button-group">
                    <button type="submit" class="btn btn-primary">
                        <span>💾</span> Save Changes
                    </button>
                    <a href="/Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

