@page
@model LinguistPro.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "User Profile";
    Layout = "_Layout";
}

<div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100">
    <!-- Header -->
    <div class="bg-white border-b border-slate-200">
        <div class="max-w-5xl mx-auto px-6 py-6 flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-bold text-slate-900">User Profile</h1>
                <p class="text-slate-500 mt-1">Manage your personal information</p>
            </div>
            <a href="/Index" class="px-4 py-2 text-slate-600 hover:text-slate-900 font-medium transition">← Back</a>
        </div>
    </div>

    <div class="max-w-5xl mx-auto px-6 py-12">
        <!-- Success Message -->
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="mb-8 p-4 bg-emerald-50 border border-emerald-200 rounded-lg flex items-start gap-3">
                <span class="text-2xl mt-1">✓</span>
                <div>
                    <p class="text-emerald-900 font-semibold">Success</p>
                    <p class="text-emerald-700 text-sm">@Model.SuccessMessage</p>
                </div>
            </div>
        }

        <!-- Error Message -->
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="mb-8 p-4 bg-red-50 border border-red-200 rounded-lg flex items-start gap-3">
                <span class="text-2xl mt-1">✗</span>
                <div>
                    <p class="text-red-900 font-semibold">Error</p>
                    <p class="text-red-700 text-sm">@Model.ErrorMessage</p>
                </div>
            </div>
        }

        <!-- Main Content Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Left Sidebar - Account Info -->
            <div class="lg:col-span-1">
                <div class="bg-white rounded-lg border border-slate-200 p-6">
                    <h2 class="text-lg font-bold text-slate-900 mb-6 flex items-center gap-2">
                        <span class="text-2xl">📧</span> Account
                    </h2>
                    <div class="space-y-4">
                        <div>
                            <p class="text-xs uppercase tracking-wide text-slate-500 font-semibold mb-2">Email Address</p>
                            <p class="text-slate-900 font-medium break-all">@Model.CurrentUserEmail</p>
                            <p class="text-xs text-slate-500 mt-2">Cannot be changed</p>
                        </div>
                    </div>
                </div>

                <!-- Quick Links -->
                <div class="mt-6 bg-white rounded-lg border border-slate-200 p-6">
                    <h3 class="text-sm font-bold text-slate-900 mb-4 uppercase tracking-wide">Other Settings</h3>
                    <div class="space-y-2">
                        <a href="/Account/ChangePassword" class="block px-4 py-2 text-slate-600 hover:bg-slate-100 rounded-lg transition font-medium text-sm">
                            🔐 Change Password
                        </a>
                        <a href="/Account/ManageLanguages" class="block px-4 py-2 text-slate-600 hover:bg-slate-100 rounded-lg transition font-medium text-sm">
                            🌐 Manage Languages
                        </a>
                    </div>
                </div>
            </div>

            <!-- Right Content - Edit Form -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-lg border border-slate-200 p-8">
                    <h2 class="text-xl font-bold text-slate-900 mb-8 flex items-center gap-2">
                        <span class="text-2xl">✏️</span> Personal Information
                    </h2>

                    <form method="post" class="space-y-6">
                        <!-- First Name -->
                        <div>
                            <label class="block text-sm font-semibold text-slate-900 mb-2">
                                First Name <span class="text-red-500">*</span>
                            </label>
                            <input asp-for="FirstName" 
                                   class="w-full px-4 py-3 border border-slate-300 rounded-lg text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition"
                                   placeholder="Enter your first name"
                                   required />
                        </div>

                        <!-- Last Name -->
                        <div>
                            <label class="block text-sm font-semibold text-slate-900 mb-2">
                                Last Name <span class="text-red-500">*</span>
                            </label>
                            <input asp-for="LastName" 
                                   class="w-full px-4 py-3 border border-slate-300 rounded-lg text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition"
                                   placeholder="Enter your last name"
                                   required />
                        </div>

                        <!-- Date of Birth -->
                        <div>
                            <label class="block text-sm font-semibold text-slate-900 mb-2">
                                Date of Birth
                            </label>
                            <input asp-for="DateOfBirth" type="date"
                                   class="w-full px-4 py-3 border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition" />
                            <p class="text-xs text-slate-500 mt-1">Optional</p>
                        </div>

                        <!-- Country -->
                        <div>
                            <label class="block text-sm font-semibold text-slate-900 mb-2">
                                Country
                            </label>
                            <input asp-for="Country" 
                                   class="w-full px-4 py-3 border border-slate-300 rounded-lg text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition"
                                   placeholder="e.g., India, United States, Germany" />
                            <p class="text-xs text-slate-500 mt-1">Optional</p>
                        </div>

                        <!-- Action Buttons -->
                        <div class="flex gap-4 pt-6 border-t border-slate-200">
                            <button type="submit" 
                                    class="flex-1 px-6 py-3 bg-indigo-600 text-white font-semibold rounded-lg hover:bg-indigo-700 transition duration-200 flex items-center justify-center gap-2">
                                <span class="text-lg">💾</span> Save Changes
                            </button>
                            <a href="/Index" 
                               class="flex-1 px-6 py-3 border border-slate-300 text-slate-700 font-semibold rounded-lg hover:bg-slate-50 transition duration-200 text-center">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
