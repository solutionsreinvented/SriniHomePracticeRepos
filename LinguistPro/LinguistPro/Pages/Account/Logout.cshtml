@page
@model LinguistPro.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Logout";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Logging out...</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-slate-50 to-slate-100 min-h-screen flex items-center justify-center">
    <div class="text-center">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-indigo-600 to-purple-600 rounded-full mb-4">
            <span style="font-size: 32px;">👋</span>
        </div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Logging out...</h1>
        <p class="text-gray-600 mb-6">Redirecting to login page.</p>
        <p class="text-sm text-gray-500">If you are not redirected, <a href="/Account/Login" class="text-indigo-600 hover:underline">click here</a>.</p>
    </div>

    <script>
        // Redirect to login after a short delay
        setTimeout(() => {
            window.location.href = '/Account/Login';
        }, 500);
    </script>
</body>
</html>
