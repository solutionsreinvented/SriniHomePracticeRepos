@page
@model LinguistPro.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";

    var languageFlagMap = new Dictionary<string, string>
    {
        { "de", "/images/flags/de.svg" },
        { "fr", "/images/flags/fr.svg" },
        { "es", "/images/flags/es.svg" },
        { "ru", "/images/flags/ru.svg" },
        { "ko", "/images/flags/ko.svg" }
    };
}

<link rel="stylesheet" href="~/css/dashboard.css">

<div class="dashboard-header">
    <div class="dashboard-header-content">
        <nav class="dashboard-nav">
            <a href="/Dashboard" class="active">📊 Dashboard</a>
            <a href="/Analytics">📈 Analytics</a>
            <a href="/Account/Profile">👤 Profile</a>
            <a href="/Index">📚 Learning</a>
        </nav>
    </div>
</div>

<div class="dashboard-container">
    <!-- Page Header -->
    <div class="dashboard-page-header">
        <h1 class="dashboard-title">
            <span class="dashboard-title-emoji">👋</span>
            Welcome to Your Learning Dashboard
        </h1>
        <p class="dashboard-subtitle">Track your progress across all languages and learning activities</p>
    </div>

    <!-- Stats Grid -->
    <div class="stats-grid">
        <!-- Total Learning -->
        <div class="stat-card">
            <div class="stat-header">
                <span class="stat-icon">📚</span>
            </div>
            <div class="stat-number">@Model.TotalItems</div>
            <div class="stat-label">Total Items Learning</div>
            <div class="stat-footer">Vocabulary, verbs, and more</div>
        </div>

        <!-- Vocabulary & Verbs -->
        <div class="stat-card">
            <div class="stat-header">
                <span class="stat-icon">📝</span>
            </div>
            <div style="font-size: 20px; font-weight: 700; color: #1a1a1a; margin-bottom: 12px;">
                @Model.VocabCount • @Model.VerbCount
            </div>
            <div class="stat-label">Vocabulary Items & Verbs</div>
            <div class="stat-footer">@Model.VocabCount vocab items, @Model.VerbCount verbs</div>
        </div>

        <!-- Other Items -->
        @if (Model.NumberCount > 0 || Model.MonthCount > 0 || Model.DayCount > 0)
        {
            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-icon">🎯</span>
                </div>
                <div style="font-size: 20px; font-weight: 700; color: #1a1a1a; margin-bottom: 12px;">
                    @(Model.NumberCount + Model.MonthCount + Model.DayCount)
                </div>
                <div class="stat-label">Numbers, Months & Days</div>
                <div class="stat-footer">
                    @if (Model.NumberCount > 0)
                    {
                        <span>@Model.NumberCount numbers</span>
                    }
                    @if (Model.MonthCount > 0)
                    {
                        <span>@(Model.NumberCount > 0 ? ", " : "")@Model.MonthCount months</span>
                    }
                    @if (Model.DayCount > 0)
                    {
                        <span>@((Model.NumberCount > 0 || Model.MonthCount > 0) ? ", " : "")@Model.DayCount days</span>
                    }
                </div>
            </div>
        }

        <!-- Average Mastery -->
        <div class="stat-card">
            <div class="stat-header">
                <span class="stat-icon">⭐</span>
            </div>
            <div class="stat-number">@Model.AverageMastery.ToString("F0")%</div>
            <div class="stat-label">Average Mastery Level</div>
            <div class="stat-footer">Across all languages</div>
        </div>
    </div>

    <!-- Divider -->
    <hr class="dashboard-divider">

    <!-- Continue Link -->
    <a href="/Index" class="continue-link">
        <span>→</span> Continue your learning journey
    </a>

    <!-- Languages Section -->
    @if (Model.LanguageStats.Count > 0)
    {
        <div class="dashboard-section">
            <h2 class="section-title">
                <span class="section-title-icon">🌐</span> Your Languages
            </h2>

            <div class="language-list">
                @foreach (var lang in Model.LanguageStats)
                {
                    var flagPath = languageFlagMap.ContainsKey(lang.LanguageCode) 
                        ? languageFlagMap[lang.LanguageCode] 
                        : "/images/flags/de.svg";

                    <div class="language-item">
                        <img class="language-flag" src="@flagPath" alt="@lang.LanguageName" title="@lang.LanguageName" />

                        <div class="language-info">
                            <div class="language-name">@lang.LanguageName</div>
                            <div class="language-stats">
                                @if (lang.VocabCount > 0)
                                {
                                    <div class="language-stat-item">
                                        <span class="language-stat-icon">📚</span>
                                        <span>@lang.VocabCount vocab</span>
                                    </div>
                                }
                                @if (lang.VerbCount > 0)
                                {
                                    <div class="language-stat-item">
                                        <span class="language-stat-icon">⚡</span>
                                        <span>@lang.VerbCount verbs</span>
                                    </div>
                                }
                                @if (lang.NumberCount > 0 || lang.MonthCount > 0 || lang.DayCount > 0)
                                {
                                    <div class="language-stat-item">
                                        <span class="language-stat-icon">🎯</span>
                                        <span>@(lang.NumberCount + lang.MonthCount + lang.DayCount) items</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="language-mastery">
                            <div class="language-mastery-value">@lang.MasteryLevel%</div>
                            <div class="language-mastery-label">Mastery</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">📚</div>
            <div class="empty-state-title">Start Your Learning Journey</div>
            <div class="empty-state-description">You haven't added any languages yet. Add your first language to begin learning!</div>
            <a href="/Account/ManageLanguages" class="empty-state-btn">Add Your First Language</a>
        </div>
    }
</div>
