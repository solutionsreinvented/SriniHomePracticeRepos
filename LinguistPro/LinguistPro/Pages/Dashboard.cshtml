@page
@model LinguistPro.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/dashboard.css">

<div class="dashboard-header">
    <div class="dashboard-header-content">
        <nav class="dashboard-nav">
            <a href="/Dashboard" class="active">Dashboard</a>
            <a href="/Account/Profile">👤 Profile</a>
            <a href="/Index">📚 Learning</a>
        </nav>
    </div>
</div>

<div class="dashboard-container">
    <!-- Page Header -->
    <div class="dashboard-page-header">
        <h1 class="dashboard-title">
            <span>👋</span> Here's your learning progress at a glance
        </h1>
    </div>

    <!-- Stats Grid -->
    <div class="stats-grid">
        <!-- Total Learning -->
        <div class="stat-card">
            <div class="stat-header">
                <span class="stat-icon">📚</span>
            </div>
            <div class="stat-number">@Model.TotalItems</div>
            <div class="stat-label">Total Items Learning</div>
        </div>

        <!-- Vocabulary & Verbs -->
        <div class="stat-card">
            <div class="stat-header">
                <span class="stat-icon">📝</span>
            </div>
            <div style="font-size: 16px; font-weight: 600; color: #000; margin-bottom: 8px;">
                @Model.VocabCount vocab • @Model.VerbCount verbs
            </div>
            <div class="stat-label">Vocabulary & Verbs</div>
        </div>

        <!-- Other Items -->
        @if (Model.NumberCount > 0 || Model.MonthCount > 0 || Model.DayCount > 0)
        {
            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-icon">🎯</span>
                </div>
                <div style="font-size: 16px; font-weight: 600; color: #000; margin-bottom: 8px;">
                    @if (Model.NumberCount > 0)
                    {
                        <span>@Model.NumberCount numbers</span>
                    }
                    @if (Model.MonthCount > 0)
                    {
                        <span>@(Model.NumberCount > 0 ? ", " : "")@Model.MonthCount months</span>
                    }
                    @if (Model.DayCount > 0)
                    {
                        <span>@((Model.NumberCount > 0 || Model.MonthCount > 0) ? ", " : "")@Model.DayCount days</span>
                    }
                </div>
                <div class="stat-label">Numbers, Months & Days</div>
            </div>
        }

        <!-- Average Mastery -->
        <div class="stat-card">
            <div class="stat-header">
                <span class="stat-icon">⭐</span>
            </div>
            <div class="stat-number">@Model.AverageMastery.ToString("F0")%</div>
            <div class="stat-label">Average Mastery</div>
        </div>
    </div>

    <!-- Divider -->
    <hr class="dashboard-divider">

    <!-- Continue Link -->
    <div style="margin-bottom: 40px;">
        <a href="/Index" class="continue-link">→ Continue your progress</a>
    </div>

    <!-- Languages Section -->
    @if (Model.LanguageStats.Count > 0)
    {
        <div class="dashboard-section">
            <h2 class="section-title">
                <span class="section-title-icon">🌐</span> Your Languages
            </h2>

            <div class="language-list">
                @foreach (var lang in Model.LanguageStats)
                {
                    <div class="language-item">
                        <span class="language-flag">
                            @if (lang.LanguageCode == "de") { <span>🇩🇪</span> }
                            else if (lang.LanguageCode == "fr") { <span>🇫🇷</span> }
                            else if (lang.LanguageCode == "es") { <span>🇪🇸</span> }
                            else if (lang.LanguageCode == "ru") { <span>🇷🇺</span> }
                        </span>

                        <div class="language-info">
                            <div class="language-name">@lang.LanguageName</div>
                            <div class="language-stats">
                                @if (lang.VocabCount > 0)
                                {
                                    <div class="language-stat-item">
                                        <span class="language-stat-icon">📚</span>
                                        <span>@lang.VocabCount vocab</span>
                                    </div>
                                }
                                @if (lang.VerbCount > 0)
                                {
                                    <div class="language-stat-item">
                                        <span class="language-stat-icon">⚡</span>
                                        <span>@lang.VerbCount verbs</span>
                                    </div>
                                }
                                @if (lang.NumberCount > 0 || lang.MonthCount > 0 || lang.DayCount > 0)
                                {
                                    <div class="language-stat-item">
                                        <span class="language-stat-icon">🎯</span>
                                        <span>@(lang.NumberCount + lang.MonthCount + lang.DayCount) items</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="language-mastery">
                            <div class="language-mastery-value">@lang.MasteryLevel%</div>
                            <div class="language-mastery-label">Mastery</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">📚</div>
            <div class="empty-state-title">No languages added yet</div>
            <div class="empty-state-description">Start learning by adding your first language</div>
            <a href="/Account/ManageLanguages" class="empty-state-btn">Add Language</a>
        </div>
    }
</div>
