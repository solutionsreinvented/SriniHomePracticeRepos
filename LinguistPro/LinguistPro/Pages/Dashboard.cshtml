@page
@model LinguistPro.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
}

<div class="min-h-screen bg-gradient-to-br from-slate-900 via-indigo-900 to-slate-900">
    <!-- Header -->
    <nav class="bg-white/10 backdrop-blur-lg border-b border-white/20 sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <a href="/Index" class="text-white text-2xl font-bold hover:text-indigo-300 transition">
                    Linguist Pro
                </a>
                <span class="px-3 py-1 bg-indigo-500/30 border border-indigo-400/50 text-indigo-200 text-xs font-bold rounded-full">Dashboard</span>
            </div>
            <div class="flex items-center gap-4">
                <a href="/Account/Profile" class="text-white/70 hover:text-white transition">👤 Profile</a>
                <a href="/Index" class="text-white/70 hover:text-white transition">📚 Learning</a>
            </div>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto px-6 py-12">
        <!-- Welcome Section -->
        <div class="mb-12">
            <h1 class="text-5xl font-bold text-white mb-2">Welcome back, @Model.UserFullName! 👋</h1>
            <p class="text-white/50 text-lg">Here's your learning progress at a glance</p>
        </div>

        <!-- Key Statistics Grid -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-12">
            <!-- Total Languages -->
            <div class="bg-white/10 backdrop-blur-xl border border-white/20 rounded-2xl p-6 hover:border-indigo-400/50 transition group">
                <div class="flex items-center justify-between mb-4">
                    <span class="text-4xl">🌐</span>
                    <span class="text-3xl font-bold text-indigo-400">@Model.TotalLanguages</span>
                </div>
                <p class="text-white font-semibold">Languages</p>
                <p class="text-white/50 text-sm">Learning</p>
            </div>

            <!-- Total Items -->
            <div class="bg-white/10 backdrop-blur-xl border border-white/20 rounded-2xl p-6 hover:border-cyan-400/50 transition group">
                <div class="flex items-center justify-between mb-4">
                    <span class="text-4xl">📚</span>
                    <span class="text-3xl font-bold text-cyan-400">@Model.TotalItems</span>
                </div>
                <p class="text-white font-semibold">Total Items</p>
                <p class="text-white/50 text-sm">Vocabulary & Verbs</p>
            </div>

            <!-- Average Mastery -->
            <div class="bg-white/10 backdrop-blur-xl border border-white/20 rounded-2xl p-6 hover:border-yellow-400/50 transition group">
                <div class="flex items-center justify-between mb-4">
                    <span class="text-4xl">⭐</span>
                    <span class="text-3xl font-bold text-yellow-400">@Model.AverageMastery.ToString("F0")%</span>
                </div>
                <p class="text-white font-semibold">Avg Mastery</p>
                <p class="text-white/50 text-sm">Across all languages</p>
            </div>

            <!-- Quick Action -->
            <div class="bg-gradient-to-br from-purple-600 to-indigo-600 rounded-2xl p-6 hover:from-purple-500 hover:to-indigo-500 transition cursor-pointer group">
                <a href="/Index" class="flex flex-col h-full">
                    <span class="text-4xl mb-4">🎯</span>
                    <p class="text-white font-semibold">Start Learning</p>
                    <p class="text-white/70 text-sm">Continue your progress</p>
                    <span class="mt-auto text-white/70 group-hover:text-white transition">→</span>
                </a>
            </div>
        </div>

        <!-- Language Progress Cards -->
        <div class="mb-12">
            <h2 class="text-3xl font-bold text-white mb-6 flex items-center gap-2">
                <span class="text-3xl">📊</span> Language Progress
            </h2>

            @if (Model.LanguageStats.Count == 0)
            {
                <div class="bg-white/5 border border-white/20 rounded-2xl p-12 text-center backdrop-blur">
                    <p class="text-white/50 text-lg mb-4">No languages added yet</p>
                    <a href="/Account/ManageLanguages" class="px-6 py-2 bg-indigo-600 text-white font-semibold rounded-lg hover:bg-indigo-500 transition">
                        Add Your First Language
                    </a>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    @foreach (var lang in Model.LanguageStats)
                    {
                        <div class="bg-white/10 backdrop-blur-xl border border-white/20 rounded-2xl p-6 hover:border-white/40 transition">
                            <!-- Language Header -->
                            <div class="flex items-center justify-between mb-6">
                                <div class="flex items-center gap-3">
                                    <div class="text-4xl">
                                        @if (lang.LanguageCode == "de")
                                        {
                                            <span>🇩🇪</span>
                                        }
                                        else if (lang.LanguageCode == "fr")
                                        {
                                            <span>🇫🇷</span>
                                        }
                                        else if (lang.LanguageCode == "es")
                                        {
                                            <span>🇪🇸</span>
                                        }
                                        else if (lang.LanguageCode == "ru")
                                        {
                                            <span>🇷🇺</span>
                                        }
                                    </div>
                                    <div>
                                        <h3 class="text-xl font-bold text-white">@lang.LanguageName</h3>
                                        @if (lang.IsActive)
                                        {
                                            <span class="text-xs text-emerald-300 font-bold">🟢 Active</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Statistics -->
                            <div class="space-y-4">
                                <!-- Items Count -->
                                <div>
                                    <div class="flex justify-between items-center mb-2">
                                        <p class="text-white/70 text-sm">Items Learned</p>
                                        <p class="text-white font-bold">@lang.ItemCount</p>
                                    </div>
                                    <div class="w-full bg-white/10 rounded-full h-2">
                                        <div class="bg-gradient-to-r from-blue-500 to-cyan-500 h-2 rounded-full" 
                                             style="width: @(Math.Min(lang.ItemCount * 5, 100))%"></div>
                                    </div>
                                </div>

                                <!-- Mastery Level -->
                                <div>
                                    <div class="flex justify-between items-center mb-2">
                                        <p class="text-white/70 text-sm">Mastery Level</p>
                                        <div class="flex items-center gap-2">
                                            @if (lang.MasteryLevel >= 80)
                                            {
                                                <span class="text-yellow-400">🏆</span>
                                            }
                                            else if (lang.MasteryLevel >= 60)
                                            {
                                                <span class="text-blue-400">🎯</span>
                                            }
                                            else if (lang.MasteryLevel >= 40)
                                            {
                                                <span class="text-purple-400">📈</span>
                                            }
                                            <p class="text-white font-bold">@lang.MasteryLevel%</p>
                                        </div>
                                    </div>
                                    <div class="w-full bg-white/10 rounded-full h-3">
                                        <div class="bg-gradient-to-r from-yellow-500 to-orange-500 h-3 rounded-full" 
                                             style="width: @lang.MasteryLevel%"></div>
                                    </div>
                                </div>

                                <!-- Quick Action -->
                                <a href="/Index?SelectedLanguage=@lang.LanguageCode"
                                   class="block mt-4 px-4 py-2 bg-white/10 border border-white/20 text-white rounded-lg hover:bg-white/20 transition text-center text-sm font-semibold">
                                    Continue Learning →
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Tips Section -->
        <div class="bg-white/5 border border-white/20 rounded-2xl p-8 backdrop-blur">
            <h3 class="text-2xl font-bold text-white mb-4 flex items-center gap-2">
                <span class="text-2xl">💡</span> Learning Tips
            </h3>
            <ul class="space-y-3">
                <li class="flex items-start gap-3 text-white/70">
                    <span class="text-xl mt-1">✓</span>
                    <span>Practice for 15 minutes daily to build consistency and improve retention</span>
                </li>
                <li class="flex items-start gap-3 text-white/70">
                    <span class="text-xl mt-1">✓</span>
                    <span>Use the virtual keyboard to type in the target language and get familiar with layouts</span>
                </li>
                <li class="flex items-start gap-3 text-white/70">
                    <span class="text-xl mt-1">✓</span>
                    <span>Review vocabulary regularly to increase your mastery level</span>
                </li>
                <li class="flex items-start gap-3 text-white/70">
                    <span class="text-xl mt-1">✓</span>
                    <span>Try adding different types of items - vocabulary, verbs, numbers, months, and days</span>
                </li>
            </ul>
        </div>
    </div>
</div>
