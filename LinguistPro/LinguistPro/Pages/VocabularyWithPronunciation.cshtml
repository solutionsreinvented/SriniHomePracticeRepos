@page "/VocabularyWithPronunciation"
@model LinguistPro.Pages.VocabularyWithPronunciationModel
@{
    ViewData["Title"] = "Vocabulary with Pronunciation";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/pronunciation-guide.css">
<link rel="stylesheet" href="~/css/vocabulary-pronunciation.css">

<div class="vocab-pronunciation-container">
    <!-- Page Header -->
    <div class="vocab-pronunciation-header">
        <h1 class="vocab-pronunciation-title">
            <span class="vocab-pronunciation-emoji">🎙️</span>
            Learn Vocabulary with Pronunciation
        </h1>
        <p class="vocab-pronunciation-subtitle">Master pronunciation with IPA transcriptions and audio playback</p>
    </div>

    <!-- Language & Filter Section -->
    <div class="vocab-filter-section">
        <div class="filter-group">
            <label for="languageSelect" class="filter-label">📚 Select Language</label>
            <select id="languageSelect" class="filter-control" onchange="filterByLanguage()">
                <option value="">-- All Languages --</option>
                @foreach (var lang in Model.AvailableLanguages)
                {
                    if (Model.SelectedLanguage == lang)
                    {
                        <option value="@lang" selected>@lang</option>
                    }
                    else
                    {
                        <option value="@lang">@lang</option>
                    }
                }
            </select>
        </div>

        <div class="filter-group">
            <label for="searchTerm" class="filter-label">🔍 Search Vocabulary</label>
            <input type="text" id="searchTerm" class="filter-control" 
                   placeholder="Search by term or meaning..."
                   onkeyup="searchVocabulary()">
        </div>

        <div class="filter-info">
            Total: <strong>@Model.VocabularyCount</strong> items
        </div>
    </div>

    <!-- Vocabulary List with Pronunciation -->
    <div class="vocabulary-grid">
        @if (Model.VocabularyWithPronunciation != null && Model.VocabularyWithPronunciation.Any())
        {
            @foreach (var item in Model.VocabularyWithPronunciation)
            {
                <div class="vocabulary-card" data-term="@item.Vocabulary.Term" data-language="@item.Vocabulary.LanguageProfile.LanguageCode">
                    <!-- Card Header -->
                    <div class="card-header">
                        <div class="card-title-section">
                            <h3 class="card-term">@item.Vocabulary.Term</h3>
                            <p class="card-meaning">@item.Vocabulary.Meaning</p>
                        </div>
                        <div class="card-language-badge">
                            @Model.GetLanguageBadge(item.Vocabulary.LanguageProfile.LanguageCode)
                        </div>
                    </div>

                    <!-- Mastery Indicator -->
                    <div class="card-mastery">
                        <span class="mastery-label">Mastery:</span>
                        <div class="mastery-bar">
                            <div class="mastery-fill" style="width: @(item.Vocabulary.Mastery)%"></div>
                        </div>
                        <span class="mastery-percent">@item.Vocabulary.Mastery%</span>
                    </div>

                    <!-- Usage Example -->
                    @if (!string.IsNullOrEmpty(item.Vocabulary.UsageExample))
                    {
                        <div class="card-usage">
                            <div class="usage-label">📝 Usage Example</div>
                            <div class="usage-text">@item.Vocabulary.UsageExample</div>
                            @if (!string.IsNullOrEmpty(item.Vocabulary.UsageExampleMeaning))
                            {
                                <div class="usage-meaning">@item.Vocabulary.UsageExampleMeaning</div>
                            }
                        </div>
                    }

                    <!-- Pronunciation Guide Component -->
                    @if (item.Pronunciation != null)
                    {
                        <div class="card-pronunciation">
                            <div class="pronunciation-header-card">
                                <h4 class="pronunciation-title-card">🎙️ Pronunciation Guide</h4>
                            </div>

                            <!-- IPA Section -->
                            <div class="pronunciation-section-card">
                                <label class="pronunciation-label-card">IPA Transcription</label>
                                <div class="pronunciation-ipa-card">
                                    <code class="ipa-code">@item.Pronunciation.IPA</code>
                                    <button class="btn-copy" onclick="copyToClipboard('@item.Pronunciation.IPA')" title="Copy IPA">
                                        📋
                                    </button>
                                </div>
                            </div>

                            <!-- Audio Playback -->
                            @if (!string.IsNullOrEmpty(item.Pronunciation.AudioUrl))
                            {
                                <div class="pronunciation-section-card">
                                    <label class="pronunciation-label-card">Audio Pronunciation</label>
                                    <div class="pronunciation-audio-card">
                                        <audio id="audio-@item.Pronunciation.PronunciationId" 
                                               src="@item.Pronunciation.AudioUrl" 
                                               preload="none">
                                        </audio>
                                        <div class="audio-controls">
                                            <button class="btn-audio" onclick="playNormal(@item.Pronunciation.PronunciationId)" title="Play Normal Speed">
                                                ▶️ Normal
                                            </button>
                                            <button class="btn-audio" onclick="playSlow(@item.Pronunciation.PronunciationId)" title="Play Slow (0.8x)">
                                                🐢 Slow
                                            </button>
                                            <button class="btn-audio" onclick="playFast(@item.Pronunciation.PronunciationId)" title="Play Fast (1.2x)">
                                                🐇 Fast
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Syllable Breakdown -->
                            @if (!string.IsNullOrEmpty(item.Pronunciation.SyllableBreakdown))
                            {
                                <div class="pronunciation-section-card">
                                    <label class="pronunciation-label-card">Syllable Breakdown</label>
                                    <div class="syllable-breakdown">@item.Pronunciation.SyllableBreakdown</div>
                                </div>
                            }

                            <!-- Pronunciation Notes -->
                            @if (!string.IsNullOrEmpty(item.Pronunciation.PronunciationNotes))
                            {
                                <div class="pronunciation-section-card">
                                    <label class="pronunciation-label-card">📚 Pronunciation Tips</label>
                                    <div class="pronunciation-notes">@item.Pronunciation.PronunciationNotes</div>
                                </div>
                            }

                            <!-- Play Count -->
                            <div class="play-count-info">
                                🎵 Listened <strong>@item.Pronunciation.PlayCount</strong> times
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="no-pronunciation">
                            <p>🎙️ No pronunciation data available</p>
                            <small>Help improve LinguistPro by adding pronunciation data!</small>
                        </div>
                    }

                    <!-- Action Buttons -->
                    <div class="card-actions">
                        <button class="btn-edit" onclick="editVocabulary(@item.Vocabulary.Id)">
                            ✏️ Edit
                        </button>
                        <a href="/Index?Mode=Vocab&SelectedLanguage=@item.Vocabulary.LanguageProfile.LanguageCode" class="btn-learn">
                            📖 Learn More
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state-pronunciation">
                <div class="empty-icon">🎙️</div>
                <div class="empty-title">No Vocabulary Found</div>
                <div class="empty-description">
                    @if (!string.IsNullOrEmpty(Model.SelectedLanguage))
                    {
                        <p>No vocabulary items with pronunciation for @Model.SelectedLanguage</p>
                    }
                    else
                    {
                        <p>No vocabulary items available yet. Start learning!</p>
                    }
                </div>
                <a href="/Index" class="empty-action-btn">📚 Go to Vocabulary</a>
            </div>
        }
    </div>
</div>

<!-- Scripts -->
<script>
    function copyToClipboard(text) {
        navigator.clipboard.writeText(text).then(function () {
            alert('IPA copied to clipboard! ✅');
        });
    }

    function playNormal(pronunciationId) {
        const audio = document.getElementById('audio-' + pronunciationId);
        if (audio) {
            audio.playbackRate = 1.0;
            audio.play();
            recordPlay(pronunciationId);
        }
    }

    function playSlow(pronunciationId) {
        const audio = document.getElementById('audio-' + pronunciationId);
        if (audio) {
            audio.playbackRate = 0.8;
            audio.play();
            recordPlay(pronunciationId);
        }
    }

    function playFast(pronunciationId) {
        const audio = document.getElementById('audio-' + pronunciationId);
        if (audio) {
            audio.playbackRate = 1.2;
            audio.play();
            recordPlay(pronunciationId);
        }
    }

    function recordPlay(pronunciationId) {
        // Optional: Send to server to increment play count
        console.log('Playing pronunciation:', pronunciationId);
    }

    function filterByLanguage() {
        const selectedLanguage = document.getElementById('languageSelect').value;
        const cards = document.querySelectorAll('.vocabulary-card');
        
        cards.forEach(card => {
            if (selectedLanguage === '' || card.getAttribute('data-language') === selectedLanguage) {
                card.style.display = 'block';
            } else {
                card.style.display = 'none';
            }
        });
    }

    function searchVocabulary() {
        const searchTerm = document.getElementById('searchTerm').value.toLowerCase();
        const cards = document.querySelectorAll('.vocabulary-card');
        
        cards.forEach(card => {
            const term = card.getAttribute('data-term').toLowerCase();
            if (term.includes(searchTerm)) {
                card.style.display = 'block';
            } else {
                card.style.display = 'none';
            }
        });
    }

    function editVocabulary(vocabId) {
        // Redirect to edit page or open modal
        window.location.href = `/Index?vocabId=${vocabId}`;
    }
</script>
