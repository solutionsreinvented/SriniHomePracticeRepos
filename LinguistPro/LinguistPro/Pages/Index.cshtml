@page
@model IndexModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Linguist Pro | Language Learning</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="bg-[#F8FAFC] text-slate-900 font-sans">
    <div class="flex h-screen">
        <aside class="w-80 bg-white border-r border-slate-200 flex flex-col">
            <div class="p-8">
                <div class="flex items-center gap-3 text-indigo-600">
                    <i class="fa-solid fa-code text-2xl"></i>
                    <h1 class="text-xl font-black tracking-tighter">LINGUIST.CORE</h1>
                </div>
            </div>

            <nav class="flex-1 px-4 space-y-2">
                <a asp-route-Mode="Vocab" class="flex items-center gap-4 p-4 rounded-2xl transition-all @(Model.Mode == "Vocab" ? "bg-indigo-600 text-white shadow-lg shadow-indigo-200" : "text-slate-500 hover:bg-slate-50")">
                    <i class="fa-solid fa-book-bookmark"></i> <span class="font-bold">Vocabulary</span>
                </a>
                <a asp-route-Mode="Verbs" class="flex items-center gap-4 p-4 rounded-2xl transition-all @(Model.Mode == "Verbs" ? "bg-indigo-600 text-white shadow-lg shadow-indigo-200" : "text-slate-500 hover:bg-slate-50")">
                    <i class="fa-solid fa-terminal"></i> <span class="font-bold">Verb Grid</span>
                </a>

                <div class="mt-12 px-4">
                    <div class="flex justify-between text-xs font-bold text-slate-400 mb-2 uppercase"><span>System Mastery</span><span>@Model.GlobalMastery.ToString("F0")%</span></div>
                    <div class="h-2 w-full bg-slate-100 rounded-full"><div class="h-full bg-indigo-500 rounded-full transition-all duration-1000" style="width: @Model.GlobalMastery%"></div></div>
                </div>
            </nav>
        </aside>

        <main class="flex-1 overflow-y-auto">
            <header class="h-20 bg-white/80 backdrop-blur-md border-b flex items-center justify-between px-10 sticky top-0 z-10">
                <div class="flex items-center gap-3">
                    <label class="text-xs font-bold text-slate-400 uppercase">Target Language:</label>
                    <select class="font-bold bg-transparent border-none focus:ring-0 text-indigo-600 cursor-pointer">
                        <option>German</option>
                        <option>French</option>
                    </select>
                </div>
                <div class="flex items-center gap-4 bg-slate-50 px-4 py-2 rounded-full border">
                    <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></div>
                    <span class="text-xs font-bold text-slate-600 uppercase">Cloud Sync Active</span>
                </div>
            </header>

            <div class="p-10">
                @if (Model.Mode == "Vocab")
                {
                    <div class="grid grid-cols-1 xl:grid-cols-2 gap-8">
                        @foreach (var word in Model.Vocabulary)
                        {
                            <div class="bg-white p-8 rounded-[2.5rem] border border-slate-200 shadow-sm hover:shadow-xl transition-all group">
                                <div class="flex justify-between items-start mb-6">
                                    <div>
                                        <h3 class="text-3xl font-black text-slate-800">@word.SourceWord</h3>
                                        <p class="text-indigo-500 font-bold italic text-lg mt-1">@word.TargetMeaning</p>
                                    </div>
                                    <span class="bg-indigo-50 text-indigo-600 text-[10px] font-black px-3 py-1 rounded-full border border-indigo-100">LEVEL @word.MasteryPoints</span>
                                </div>
                                <div class="space-y-4">
                                    <p class="text-slate-500 leading-relaxed"><b class="text-slate-800 font-bold uppercase text-[10px] block mb-1">Contextual Info</b> @word.Definition</p>
                                    <p class="bg-slate-50 p-4 rounded-2xl border-l-4 border-indigo-400 font-medium text-slate-700">@word.UsageExample</p>
                                </div>
                                <form method="post" asp-page-handler="LogProgress" asp-route-id="@word.Id" class="mt-8">
                                    <button class="w-full bg-slate-900 text-white py-4 rounded-2xl font-bold hover:bg-indigo-600 transition-all">Advance Progress</button>
                                </form>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="bg-white rounded-[3rem] border border-slate-200 shadow-xl overflow-hidden">
                        <table class="w-full text-left">
                            <thead class="bg-slate-50 border-b border-slate-100">
                                <tr>
                                    <th class="p-8 font-black text-slate-400 uppercase text-xs">Infinitive Base</th>
                                    <th class="p-8 font-black text-slate-400 uppercase text-xs">Translation</th>
                                    <th class="p-8"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var verb in Model.Verbs)
                                {
                                    <tr class="border-b border-slate-50 last:border-none group">
                                        <td class="p-8 text-2xl font-black text-slate-800">@verb.Infinitive</td>
                                        <td class="p-8 text-slate-400 italic text-xl">@verb.Meaning</td>
                                        <td class="p-8 text-right">
                                            <button onclick="document.getElementById('m-@verb.Id').classList.remove('hidden')" class="bg-indigo-600 text-white px-8 py-3 rounded-2xl font-black text-sm uppercase shadow-lg shadow-indigo-100">Conjugate</button>
                                        </td>
                                    </tr>

                                    <div id="m-@verb.Id" class="hidden fixed inset-0 bg-slate-900/40 backdrop-blur-md z-50 flex items-center justify-center p-6">
                                        <div class="bg-white rounded-[3rem] max-w-2xl w-full p-12 shadow-2xl relative">
                                            <button onclick="this.closest('#m-@verb.Id').classList.add('hidden')" class="absolute top-10 right-10 text-slate-300 hover:text-slate-900 text-3xl">×</button>

                                            <h2 class="text-4xl font-black mb-10 text-slate-900">Analysis: <span class="text-indigo-600">@verb.Infinitive</span></h2>

                                            <div class="grid grid-cols-3 border border-slate-200 rounded-3xl overflow-hidden">
                                                <div class="p-5 bg-slate-50 border-b border-r text-[10px] font-black text-slate-400 uppercase">Person</div>
                                                <div class="p-5 bg-slate-50 border-b border-r text-sm font-black text-slate-800">Singular</div>
                                                <div class="p-5 bg-slate-50 border-b text-sm font-black text-slate-800">Plural</div>

                                                <div class="p-6 bg-slate-50 border-b border-r font-bold text-slate-500">First</div>
                                                <div class="p-6 border-b border-r text-indigo-600 font-black italic"><span class="text-slate-300 text-[10px] mr-1">ich</span> @verb.S1</div>
                                                <div class="p-6 border-b font-bold"><span class="text-slate-300 text-[10px] mr-1">wir</span> @verb.P1</div>

                                                <div class="p-6 bg-slate-50 border-b border-r font-bold text-slate-500">Second (Informal)</div>
                                                <div class="p-6 border-b border-r text-indigo-600 font-black italic"><span class="text-slate-300 text-[10px] mr-1">du</span> @verb.S2</div>
                                                <div class="p-6 border-b font-bold"><span class="text-slate-300 text-[10px] mr-1">ihr</span> @verb.P2</div>

                                                <div class="p-6 bg-indigo-50 border-b border-r font-bold text-indigo-600">Second (Formal)</div>
                                                <div class="p-6 border-b border-r text-indigo-700 font-black italic bg-indigo-50/20"><span class="text-indigo-300 text-[10px] mr-1">Sie</span> @verb.S2F</div>
                                                <div class="p-6 border-b font-bold bg-indigo-50/20"><span class="text-indigo-300 text-[10px] mr-1">Sie</span> @verb.P2F</div>

                                                <div class="p-6 bg-slate-50 border-r font-bold text-slate-500">Third</div>
                                                <div class="p-6 border-r text-indigo-600 font-black italic"><span class="text-slate-300 text-[10px] mr-1">er/sie/es</span> @verb.S3</div>
                                                <div class="p-6 font-bold"><span class="text-slate-300 text-[10px] mr-1">sie</span> @verb.P3</div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </main>
    </div>
</body>
</html>