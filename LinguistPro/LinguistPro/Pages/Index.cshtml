@page
@model LinguistPro.Pages.IndexModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Linguist Pro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            font-size: 14px;
        }

        .card {
            border-radius: 8px;
        }

        .pronoun {
            font-size: 0.95rem;
            opacity: .6;
            margin-right: 4px;
        }

        input, textarea, select {
            font-size: 13px;
        }
    </style>
</head>

<body class="bg-slate-50 text-slate-800 h-screen overflow-hidden">
    <div class="flex h-full">

        <!-- SIDEBAR -->
        <aside class="w-64 bg-white border-r">
            <div class="p-4 border-b text-indigo-600 font-semibold">
                Linguist Pro
            </div>

            <nav class="p-3 text-sm space-y-1">
                <a asp-route-Mode="Vocab"
                   class="block px-3 py-2 rounded @(Model.Mode == "Vocab" ? "bg-indigo-50" : "hover:bg-slate-100")">
                    Vocabulary
                </a>
                <a asp-route-Mode="Verbs"
                   class="block px-3 py-2 rounded @(Model.Mode == "Verbs" ? "bg-indigo-50" : "hover:bg-slate-100")">
                    Verbs
                </a>
            </nav>
        </aside>

        <!-- MAIN -->
        <main class="flex-1 flex flex-col">

            <!-- HEADER -->
            <header class="h-14 bg-white border-b flex items-center justify-between px-4">
                <form method="get">
                    <select name="SelectedLanguage"
                            onchange="this.form.submit()"
                            class="border px-2 py-1 rounded">
                        <option value="de" selected>German</option>
                        <option value="fr">French</option>
                        <option value="es">Spanish</option>
                    </select>
                </form>

                <div class="text-xs text-slate-500">
                    Mastery @Model.GlobalMastery%
                </div>
            </header>

            <!-- CONTENT -->
            <div class="flex-1 overflow-y-auto p-4">

                @if (Model.Mode == "Vocab")
                {
                    <form method="post" asp-page-handler="AddVocabulary"
                          class="bg-white p-4 border rounded mb-4 space-y-2">

                        <div class="flex gap-2">
                            <input name="ManualTerm" placeholder="Word"
                                   class="border px-2 py-1 rounded w-40" />
                            <input name="ManualMeaning" placeholder="Meaning"
                                   class="border px-2 py-1 rounded flex-1" />
                        </div>

                        <textarea name="ManualUsage"
                              placeholder="Usage example"
                              class="border px-2 py-1 rounded w-full h-16"></textarea>

                        <label class="text-xs flex items-center gap-2">
                            <input type="checkbox" name="FetchVocabularyOnline" />
                            Fetch from online
                        </label>

                        <button class="bg-indigo-600 text-white px-4 py-1 rounded text-sm">
                            Add Vocabulary
                        </button>
                    </form>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
                        @foreach (var v in Model.Vocabulary)
                        {
                            <div class="bg-white border p-3 card">
                                <div class="font-semibold">@v.Term</div>
                                <div class="text-slate-500 italic text-sm">@v.Meaning</div>
                                <div class="text-sm mt-1">@v.UsageExample</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <form method="post" asp-page-handler="AddVerb"
                          class="bg-white p-4 border rounded mb-4 space-y-2">

                        <input asp-for="ManualVerb.Infinitive"
                               placeholder="Infinitive"
                               class="border px-2 py-1 rounded w-40" />

                        <label class="text-xs flex items-center gap-2">
                            <input type="checkbox" name="FetchVerbOnline" />
                            Fetch from online
                        </label>

                        <div class="grid grid-cols-2 gap-2 text-sm">
                            <input asp-for="ManualVerb.S1" placeholder="1st sg" class="border px-2 py-1 rounded" />
                            <input asp-for="ManualVerb.P1" placeholder="1st pl" class="border px-2 py-1 rounded" />
                            <input asp-for="ManualVerb.S2Inf" placeholder="2nd sg (inf)" class="border px-2 py-1 rounded" />
                            <input asp-for="ManualVerb.P2Inf" placeholder="2nd pl (inf)" class="border px-2 py-1 rounded" />
                            <input asp-for="ManualVerb.S2Form" placeholder="2nd sg (form)" class="border px-2 py-1 rounded" />
                            <input asp-for="ManualVerb.P2Form" placeholder="2nd pl (form)" class="border px-2 py-1 rounded" />
                            <input asp-for="ManualVerb.S3" placeholder="3rd sg" class="border px-2 py-1 rounded" />
                            <input asp-for="ManualVerb.P3" placeholder="3rd pl" class="border px-2 py-1 rounded" />
                        </div>

                        <button class="bg-indigo-600 text-white px-4 py-1 rounded text-sm">
                            Add Verb
                        </button>
                    </form>

                    <table class="w-full bg-white border rounded text-sm">
                        @foreach (var verb in Model.VerbList)
                        {
                            <tr class="border-b">
                                <td class="p-2 font-semibold">@verb.Infinitive</td>
                                <td class="p-2 italic text-slate-500">@verb.Meaning</td>
                            </tr>
                            <tr class="bg-slate-50">
                                <td colspan="2" class="p-2">
                                    <div class="grid grid-cols-3 gap-2">
                                        <div><span class="pronoun">ich</span>@verb.S1</div>
                                        <div><span class="pronoun">du</span>@verb.S2Inf</div>
                                        <div><span class="pronoun">er/sie/es</span>@verb.S3</div>
                                        <div><span class="pronoun">wir</span>@verb.P1</div>
                                        <div><span class="pronoun">ihr</span>@verb.P2Inf</div>
                                        <div><span class="pronoun">sie</span>@verb.P3</div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </table>
                }

            </div>
        </main>
    </div>
</body>
</html>
