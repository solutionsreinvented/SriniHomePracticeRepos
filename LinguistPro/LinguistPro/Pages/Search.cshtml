@page
@model LinguistPro.Pages.SearchModel
@{
    ViewData["Title"] = "Search & Filter";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/search.css">

<div class="search-container">
    <!-- Search Header -->
    <div class="search-header">
        <h1 class="search-title">🔍 Search & Filter</h1>
        <p class="search-subtitle">Find items across your vocabulary and language learning</p>
    </div>

    <div class="search-layout">
        <!-- Filters Sidebar -->
        <aside class="search-sidebar">
            <form method="get" class="search-filters-form">
                <div class="filter-group">
                    <h3 class="filter-title">Search</h3>
                    <input type="text" name="searchTerm" placeholder="Search term..." 
                           value="@Model.Criteria?.SearchTerm" class="form-control search-input">
                </div>

                <div class="filter-group">
                    <h3 class="filter-title">Item Type</h3>
                    <div class="checkbox-group">
                        <label class="checkbox-label">
                            <input type="checkbox" name="itemType" value="Vocabulary" 
                                   @{if (Model.Criteria?.ItemType == "Vocabulary") { @Html.Raw("checked"); }} />
                            📚 Vocabulary
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" name="itemType" value="Number" 
                                   @{if (Model.Criteria?.ItemType == "Number") { @Html.Raw("checked"); }} />
                            🔢 Numbers
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" name="itemType" value="Month" 
                                   @{if (Model.Criteria?.ItemType == "Month") { @Html.Raw("checked"); }} />
                            📅 Months
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" name="itemType" value="Day" 
                                   @{if (Model.Criteria?.ItemType == "Day") { @Html.Raw("checked"); }} />
                            📆 Days
                        </label>
                    </div>
                </div>

                <div class="filter-group">
                    <h3 class="filter-title">Mastery Level</h3>
                    <div class="mastery-range">
                        <label>Min: <span id="minValue">@(Model.Criteria?.MasteryMinimum ?? 0)</span>%</label>
                        <input type="range" name="masteryMin" min="0" max="100" step="10" 
                               value="@(Model.Criteria?.MasteryMinimum ?? 0)" class="range-slider">
                    </div>
                    <div class="mastery-range">
                        <label>Max: <span id="maxValue">@(Model.Criteria?.MasteryMaximum ?? 100)</span>%</label>
                        <input type="range" name="masteryMax" min="0" max="100" step="10" 
                               value="@(Model.Criteria?.MasteryMaximum ?? 100)" class="range-slider">
                    </div>
                </div>

                <div class="filter-group">
                    <h3 class="filter-title">Quick Filters</h3>
                    <div class="checkbox-group">
                        <label class="checkbox-label">
                            <input type="checkbox" name="showOnlyUnmastered" 
                                   @{if (Model.Criteria?.ShowOnlyUnmastered == true) { @Html.Raw("checked"); }} />
                            ⭐ Show Only Unmastered
                        </label>
                    </div>
                </div>

                <div class="filter-group">
                    <h3 class="filter-title">Sort By</h3>
                    <select name="sortBy" class="form-control">
                        @{
                            var sortOptions = new[] {
                                ("term", "Term (A-Z)"),
                                ("mastery", "Mastery Level"),
                                ("lastreviewed", "Last Reviewed")
                            };
                        }
                        @foreach (var (value, label) in sortOptions)
                        {
                            if (Model.Criteria?.SortBy == value)
                            {
                                <option value="@value" selected>@label</option>
                            }
                            else
                            {
                                <option value="@value">@label</option>
                            }
                        }
                    </select>
                </div>

                <div class="filter-actions">
                    <button type="submit" class="btn btn-primary">🔍 Search</button>
                    <a href="/Search" class="btn btn-secondary">🔄 Clear Filters</a>
                </div>
            </form>
        </aside>

        <!-- Results Main Content -->
        <main class="search-main">
            @if (Model.Results?.Items.Count > 0)
            {
                <!-- Results Info -->
                <div class="results-info">
                    <p class="results-summary">
                        Found <strong>@Model.Results.TotalCount</strong> item(s) 
                        @if (!string.IsNullOrWhiteSpace(Model.Criteria?.SearchTerm))
                        {
                            <span>matching "<strong>@Model.Criteria.SearchTerm</strong>"</span>
                        }
                    </p>
                    <p class="results-pagination">
                        Page @Model.Results.PageNumber of @Model.Results.TotalPages
                    </p>
                </div>

                <!-- Results List -->
                <div class="results-list">
                    @foreach (var item in Model.Results.Items)
                    {
                        <div class="result-item">
                            <div class="result-header">
                                <h4 class="result-term">@item.Term</h4>
                                <span class="result-mastery" style="width: @(item.Mastery)%; background: @GetMasteryColor(item.Mastery);">
                                    @item.Mastery%
                                </span>
                            </div>
                            <p class="result-meaning">@item.Meaning</p>
                            @if (!string.IsNullOrEmpty(item.Definition))
                            {
                                <p class="result-definition">📝 @item.Definition</p>
                            }
                            <div class="result-meta">
                                <span class="meta-review">🔄 Reviewed: @item.LastReviewed.ToString("MMM dd, yyyy")</span>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.Results.TotalPages > 1)
                {
                    <div class="pagination">
                        @if (Model.Results.HasPreviousPage)
                        {
                            <a href="@GetPaginationUrl(Model.Results.PageNumber - 1)" class="btn btn-small">← Previous</a>
                        }
                        
                        <span class="page-info">Page @Model.Results.PageNumber of @Model.Results.TotalPages</span>
                        
                        @if (Model.Results.HasNextPage)
                        {
                            <a href="@GetPaginationUrl(Model.Results.PageNumber + 1)" class="btn btn-small">Next →</a>
                        }
                    </div>
                }
            }
            else
            {
                <div class="empty-results">
                    <div class="empty-icon">🔍</div>
                    <h3>No results found</h3>
                    <p>Try adjusting your filters or search terms</p>
                    <a href="/Search" class="btn btn-primary">Clear All Filters</a>
                </div>
            }
        </main>
    </div>
</div>

@functions {
    string GetMasteryColor(int mastery)
    {
        if (mastery >= 90) return "#4CAF50"; // Green
        if (mastery >= 70) return "#FFC107"; // Orange
        if (mastery >= 50) return "#FF9800"; // Deep Orange
        return "#F44336"; // Red
    }

    string GetPaginationUrl(int pageNumber)
    {
        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(Model.Criteria?.SearchTerm))
            query.Add($"searchTerm={Uri.EscapeDataString(Model.Criteria.SearchTerm)}");
        if (Model.Criteria?.MasteryMinimum.HasValue == true)
            query.Add($"masteryMin={Model.Criteria.MasteryMinimum}");
        if (Model.Criteria?.MasteryMaximum.HasValue == true)
            query.Add($"masteryMax={Model.Criteria.MasteryMaximum}");
        if (!string.IsNullOrWhiteSpace(Model.Criteria?.ItemType))
            query.Add($"itemType={Model.Criteria.ItemType}");
        query.Add($"pageNumber={pageNumber}");
        return $"/Search?{string.Join("&", query)}";
    }
}
