@page
@model LinguistPro.Pages.AnalyticsModel
@{
    ViewData["Title"] = "Learning Analytics";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/analytics.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js"></script>

<div class="dashboard-header">
    <div class="dashboard-header-content">
        <nav class="dashboard-nav">
            <a href="/Dashboard">📊 Dashboard</a>
            <a href="/Analytics" class="active">📈 Analytics</a>
            <a href="/Account/Profile">👤 Profile</a>
            <a href="/Index">📚 Learning</a>
        </nav>
    </div>
</div>

@{
    var languageFlagMap = new Dictionary<string, string>
    {
        { "de", "/images/flags/de.svg" },
        { "fr", "/images/flags/fr.svg" },
        { "es", "/images/flags/es.svg" },
        { "ru", "/images/flags/ru.svg" },
        { "ko", "/images/flags/ko.svg" }
    };
}

<div class="analytics-container">
    <!-- Page Header -->
    <div class="analytics-page-header">
        <h1 class="analytics-title">
            <span class="analytics-title-emoji">📈</span>
            Your Learning Analytics
        </h1>
        <p class="analytics-subtitle">Visualize your progress, track mastery levels, and understand your learning patterns</p>
    </div>

    <!-- Quick Stats -->
    <div class="quick-stats-grid">
        <div class="quick-stat">
            <div class="quick-stat-icon">⏱️</div>
            <div class="quick-stat-value">@Model.TotalLearningDays</div>
            <div class="quick-stat-label">Learning Days</div>
        </div>
        <div class="quick-stat">
            <div class="quick-stat-icon">📚</div>
            <div class="quick-stat-value">@Model.TotalItems</div>
            <div class="quick-stat-label">Total Items</div>
        </div>
        <div class="quick-stat">
            <div class="quick-stat-icon">⭐</div>
            <div class="quick-stat-value">@Model.AverageMastery.ToString("F1")%</div>
            <div class="quick-stat-label">Avg Mastery</div>
        </div>
        <div class="quick-stat">
            <div class="quick-stat-icon">🎯</div>
            <div class="quick-stat-value">@Model.EstimatedDaysToFluency</div>
            <div class="quick-stat-label">Days to Fluency</div>
        </div>
    </div>

    <!-- Charts Grid -->
    <div class="charts-container">
        <!-- Chart 1: Learning Items per Language -->
        <div class="chart-card">
            <h2 class="chart-title">Learning Items by Language</h2>
            <div class="chart-wrapper">
                <canvas id="itemsPerLanguageChart"></canvas>
            </div>
            <p class="chart-description">Distribution of vocabulary, verbs, and other items across your languages</p>
        </div>

        <!-- Chart 2: Mastery Level by Language -->
        <div class="chart-card">
            <h2 class="chart-title">Mastery Level by Language</h2>
            <div class="chart-wrapper">
                <canvas id="masteryByLanguageChart"></canvas>
            </div>
            <p class="chart-description">Current mastery percentage for each language you're learning</p>
        </div>

        <!-- Chart 3: Mastery by Item Type -->
        @if (Model.MasteryByItemType.Count > 0)
        {
            <div class="chart-card">
                <h2 class="chart-title">Mastery by Item Type</h2>
                <div class="chart-wrapper">
                    <canvas id="masteryByTypeChart"></canvas>
                </div>
                <p class="chart-description">How well you're mastering different types of content</p>
            </div>
        }

        <!-- Chart 4: Learning Activity Heatmap -->
        @if (Model.DailyLearningData.Count > 0)
        {
            <div class="chart-card chart-card-full">
                <h2 class="chart-title">Daily Learning Activity (Last 30 Days)</h2>
                <div class="chart-wrapper heatmap-wrapper">
                    <canvas id="dailyActivityChart"></canvas>
                </div>
                <p class="chart-description">Your learning consistency over the past month</p>
            </div>
        }
    </div>

    <!-- Language Details Section -->
    @if (Model.LanguageStats.Count > 0)
    {
        <div class="language-details-section">
            <h2 class="section-title">
                <span class="section-icon">🌐</span> Detailed Language Analytics
            </h2>

            <div class="language-details-grid">
                @foreach (var lang in Model.LanguageStats)
                {
                    var flagPath = languageFlagMap.ContainsKey(lang.LanguageCode)
                        ? languageFlagMap[lang.LanguageCode]
                        : "/images/flags/de.svg";

                    <div class="language-detail-card">
                        <div class="language-detail-header">
                            <img class="language-detail-flag" src="@flagPath" alt="@lang.LanguageName" />
                            <h3 class="language-detail-name">@lang.LanguageName</h3>
                        </div>

                        <div class="language-detail-stats">
                            <div class="detail-stat">
                                <span class="detail-stat-label">📚 Vocabulary</span>
                                <span class="detail-stat-value">@lang.VocabCount</span>
                            </div>
                            <div class="detail-stat">
                                <span class="detail-stat-label">⚡ Verbs</span>
                                <span class="detail-stat-value">@lang.VerbCount</span>
                            </div>
                            <div class="detail-stat">
                                <span class="detail-stat-label">🎯 Other Items</span>
                                <span class="detail-stat-value">@(lang.NumberCount + lang.MonthCount + lang.DayCount)</span>
                            </div>
                        </div>

                        <div class="language-detail-progress">
                            <div class="progress-label">
                                <span>Mastery Level</span>
                                <span class="progress-value">@lang.MasteryLevel%</span>
                            </div>
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: @lang.MasteryLevel%"></div>
                            </div>
                        </div>

                        @if (lang.EstimatedDaysToFluency > 0 && lang.EstimatedDaysToFluency <= 365)
                        {
                            <div class="language-detail-info">
                                <p>Estimated <strong>@lang.EstimatedDaysToFluency days</strong> to fluency</p>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <!-- Weekly Statistics -->
    @if (Model.WeeklyStats.Count > 0)
    {
        <div class="weekly-stats-section">
            <h2 class="section-title">
                <span class="section-icon">📅</span> Weekly Summary
            </h2>

            <div class="weekly-stats-list">
                @foreach (var week in Model.WeeklyStats.Take(4))
                {
                    <div class="weekly-stat-card">
                        <div class="weekly-stat-period">@week.Period</div>
                        <div class="weekly-stat-items">
                            <div class="weekly-stat-item">
                                <span class="weekly-stat-label">Items Reviewed</span>
                                <span class="weekly-stat-number">@week.ItemsReviewed</span>
                            </div>
                            <div class="weekly-stat-item">
                                <span class="weekly-stat-label">Avg Mastery</span>
                                <span class="weekly-stat-number">@week.AverageMastery.ToString("F1")%</span>
                            </div>
                            <div class="weekly-stat-item">
                                <span class="weekly-stat-label">Days Active</span>
                                <span class="weekly-stat-number">@week.DaysActive</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<script>
    // Chart Color Schemes
    const colors = {
        primary: '#667eea',
        secondary: '#764ba2',
        success: '#10b981',
        warning: '#f59e0b',
        danger: '#ef4444',
        info: '#3b82f6',
        lightGray: '#e5e7eb',
        gray: '#9ca3af'
    };

    const languageColors = ['#667eea', '#764ba2', '#f59e0b', '#10b981', '#ef4444', '#3b82f6', '#8b5cf6'];

    // Chart 1: Items Per Language (Bar Chart)
    const itemsPerLanguageCtx = document.getElementById('itemsPerLanguageChart')?.getContext('2d');
    if (itemsPerLanguageCtx) {
        new Chart(itemsPerLanguageCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LanguageStats.Select(l => l.LanguageName).ToList())),
                datasets: [
                    {
                        label: 'Vocabulary',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LanguageStats.Select(l => l.VocabCount).ToList())),
                        backgroundColor: colors.primary,
                        borderRadius: 6
                    },
                    {
                        label: 'Verbs',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LanguageStats.Select(l => l.VerbCount).ToList())),
                        backgroundColor: colors.secondary,
                        borderRadius: 6
                    },
                    {
                        label: 'Other Items',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LanguageStats.Select(l => l.NumberCount + l.MonthCount + l.DayCount).ToList())),
                        backgroundColor: colors.warning,
                        borderRadius: 6
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            font: { size: 12, weight: 500 },
                            padding: 16,
                            usePointStyle: true
                        }
                    }
                },
                scales: {
                    x: {
                        stacked: false,
                        grid: { drawBorder: false, color: 'transparent' },
                        ticks: { font: { size: 12 } }
                    },
                    y: {
                        stacked: false,
                        grid: { color: colors.lightGray },
                        ticks: { font: { size: 12 } }
                    }
                }
            }
        });
    }

    // Chart 2: Mastery by Language (Line Chart)
    const masteryByLanguageCtx = document.getElementById('masteryByLanguageChart')?.getContext('2d');
    if (masteryByLanguageCtx) {
        new Chart(masteryByLanguageCtx, {
            type: 'line',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LanguageStats.Select(l => l.LanguageName).ToList())),
                datasets: [{
                    label: 'Mastery Level (%)',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LanguageStats.Select(l => l.MasteryLevel).ToList())),
                    borderColor: colors.primary,
                    backgroundColor: 'rgba(102, 126, 234, 0.1)',
                    borderWidth: 3,
                    fill: true,
                    tension: 0.4,
                    pointRadius: 6,
                    pointBackgroundColor: colors.primary,
                    pointBorderColor: 'white',
                    pointBorderWidth: 2,
                    pointHoverRadius: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        labels: {
                            font: { size: 12, weight: 500 },
                            padding: 16
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 100,
                        grid: { color: colors.lightGray },
                        ticks: { font: { size: 12 } }
                    }
                }
            }
        });
    }

    // Chart 3: Mastery by Type (Pie Chart)
    @if (Model.MasteryByItemType.Count > 0)
    {
        <text>
    const masteryByTypeCtx = document.getElementById('masteryByTypeChart')?.getContext('2d');
    if (masteryByTypeCtx) {
        new Chart(masteryByTypeCtx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MasteryByItemType.Keys.ToList())),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MasteryByItemType.Values.ToList())),
                    backgroundColor: languageColors,
                    borderColor: 'white',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            font: { size: 12, weight: 500 },
                            padding: 16,
                            usePointStyle: true
                        }
                    }
                }
            }
        });
    }
        </text>
    }

    // Chart 4: Daily Activity (Bar Chart)
    @if (Model.DailyLearningData.Count > 0)
    {
        <text>
    const dailyActivityCtx = document.getElementById('dailyActivityChart')?.getContext('2d');
    if (dailyActivityCtx) {
        new Chart(dailyActivityCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyLearningData.Select(d => d.Date.ToString("MMM dd")).ToList())),
                datasets: [{
                    label: 'Items Reviewed',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyLearningData.Select(d => d.ItemsLearned).ToList())),
                    backgroundColor: colors.primary,
                    borderRadius: 6,
                    borderSkipped: false
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                indexAxis: 'x',
                plugins: {
                    legend: {
                        labels: {
                            font: { size: 12, weight: 500 },
                            padding: 16
                        }
                    }
                },
                scales: {
                    y: {
                        grid: { color: colors.lightGray },
                        ticks: { font: { size: 12 } }
                    }
                }
            }
        });
    }
        </text>
    }
</script>
