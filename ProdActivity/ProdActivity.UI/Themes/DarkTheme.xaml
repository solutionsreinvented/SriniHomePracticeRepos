<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Dark Theme: Deep space dark with violet-indigo accents
        Fluent UI inspired – rich depth, elevated surfaces
    -->

    <!-- Core Colors -->
    <Color x:Key="WindowBackgroundColor">#0F0F13</Color>
    <Color x:Key="CardBackgroundColor">#1C1C27</Color>
    <Color x:Key="TitleBarBackgroundColor">#16161F</Color>
    <Color x:Key="SidebarBackgroundColor">#16161F</Color>

    <!-- Accent: Violet-indigo, cohesive with the reference purple -->
    <Color x:Key="AccentColor">#7C6BEA</Color>
    <Color x:Key="AccentHoverColor">#9B8EF5</Color>
    <Color x:Key="AccentLightColor">#2D284B</Color>

    <!-- Text Colors -->
    <Color x:Key="PrimaryTextColor">#F0EFFF</Color>
    <Color x:Key="SecondaryTextColor">#8B8FAD</Color>
    <Color x:Key="TertiaryTextColor">#5A5E7A</Color>
    <Color x:Key="InverseTextColor">#0F0F13</Color>

    <!-- Surface Colors -->
    <Color x:Key="BorderColor">#2A2A3D</Color>
    <Color x:Key="InputBackgroundColor">#13131C</Color>
    <Color x:Key="HoverBackgroundColor">#23233A</Color>
    <Color x:Key="SelectedRowColor">#2D284B</Color>

    <!-- Status Colors -->
    <Color x:Key="SuccessColor">#34D399</Color>
    <Color x:Key="DangerColor">#F87171</Color>
    <Color x:Key="WarningColor">#FBBF24</Color>

    <!-- Core Brushes -->
    <SolidColorBrush x:Key="WindowBackgroundBrush"    Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush"      Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="TitleBarBackgroundBrush"  Color="{StaticResource TitleBarBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush"   Color="{StaticResource SidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="AccentBrush"              Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush"         Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush"         Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush"         Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush"       Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="TertiaryTextBrush"        Color="{StaticResource TertiaryTextColor}"/>
    <SolidColorBrush x:Key="InverseTextBrush"         Color="{StaticResource InverseTextColor}"/>
    <SolidColorBrush x:Key="BorderBrush"              Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="InputBackgroundBrush"     Color="{StaticResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush"     Color="{StaticResource HoverBackgroundColor}"/>
    <SolidColorBrush x:Key="SelectedRowBrush"         Color="{StaticResource SelectedRowColor}"/>
    <SolidColorBrush x:Key="SuccessBrush"             Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="DangerBrush"              Color="{StaticResource DangerColor}"/>

    <!-- Window Chrome Button Colors -->
    <SolidColorBrush x:Key="WindowButtonForegroundBrush"  Color="#5A5E7A"/>
    <SolidColorBrush x:Key="CloseButtonHoverBrush"         Color="#F87171"/>
    <SolidColorBrush x:Key="MinMaxButtonHoverBrush"        Color="#2A2A3D"/>

    <!-- Backward Compatibility -->
    <SolidColorBrush x:Key="StaticBackgroundBrush"            Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="StaticForegroundBrush"            Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="StaticBorderBrush"                Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="MouseOverBackgroundGradientBrush" Color="{StaticResource AccentColor}"/>

</ResourceDictionary>

