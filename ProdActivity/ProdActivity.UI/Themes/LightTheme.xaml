<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Light Theme: Club Members Dashboard style
        Reference: Deep navy sidebar, white canvas, vibrant violet accent
    -->

    <!-- Core Colors -->
    <Color x:Key="WindowBackgroundColor">#F0F2FF</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="TitleBarBackgroundColor">#FFFFFF</Color>
    <Color x:Key="SidebarBackgroundColor">#1E1B4B</Color>

    <!-- Accent: Vibrant violet-blue from reference image -->
    <Color x:Key="AccentColor">#5840D8</Color>
    <Color x:Key="AccentHoverColor">#4732C0</Color>
    <Color x:Key="AccentLightColor">#EDE9FF</Color>

    <!-- Text Colors -->
    <Color x:Key="PrimaryTextColor">#1E1B4B</Color>
    <Color x:Key="SecondaryTextColor">#6B7280</Color>
    <Color x:Key="TertiaryTextColor">#9CA3AF</Color>
    <Color x:Key="InverseTextColor">#FFFFFF</Color>

    <!-- Surface Colors -->
    <Color x:Key="BorderColor">#E5E7EB</Color>
    <Color x:Key="InputBackgroundColor">#F9FAFB</Color>
    <Color x:Key="HoverBackgroundColor">#F3F4F6</Color>
    <Color x:Key="SelectedRowColor">#EDE9FF</Color>

    <!-- Status Colors -->
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>

    <!-- Core Brushes -->
    <SolidColorBrush x:Key="WindowBackgroundBrush"    Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush"      Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="TitleBarBackgroundBrush"  Color="{StaticResource TitleBarBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush"   Color="{StaticResource SidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="AccentBrush"              Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush"         Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush"         Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush"         Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush"       Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="TertiaryTextBrush"        Color="{StaticResource TertiaryTextColor}"/>
    <SolidColorBrush x:Key="InverseTextBrush"         Color="{StaticResource InverseTextColor}"/>
    <SolidColorBrush x:Key="BorderBrush"              Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="InputBackgroundBrush"     Color="{StaticResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush"     Color="{StaticResource HoverBackgroundColor}"/>
    <SolidColorBrush x:Key="SelectedRowBrush"         Color="{StaticResource SelectedRowColor}"/>
    <SolidColorBrush x:Key="SuccessBrush"             Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="DangerBrush"              Color="{StaticResource DangerColor}"/>

    <!-- Window Chrome Button Colors -->
    <SolidColorBrush x:Key="WindowButtonForegroundBrush"  Color="#9CA3AF"/>
    <SolidColorBrush x:Key="CloseButtonHoverBrush"         Color="#EF4444"/>
    <SolidColorBrush x:Key="MinMaxButtonHoverBrush"        Color="#E5E7EB"/>

    <!-- Backward Compatibility -->
    <SolidColorBrush x:Key="StaticBackgroundBrush"            Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="StaticForegroundBrush"            Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="StaticBorderBrush"                Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="MouseOverBackgroundGradientBrush" Color="{StaticResource AccentColor}"/>

</ResourceDictionary>

