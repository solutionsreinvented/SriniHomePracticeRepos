<Window
    x:Class="ProdActivity.UI.Home"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ProdActivity.UI.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="http://schemas.reinvented.com/shared"
    x:Name="Root"
    Width="{StaticResource MainWindowWidth}"
    Height="{StaticResource MainWindowHeight}"
    Background="{DynamicResource WindowBackgroundBrush}"
    Focusable="False"
    FontFamily="Segoe UI, Roboto, Tahoma, sans-serif"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="45" CornerRadius="12" GlassFrameThickness="0" ResizeBorderThickness="5" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <!--#region Window Header-->

        <Border Height="52" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Logo + Name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0">
                        <TextBlock Text="PA" Foreground="White" FontWeight="Bold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="ProdActivity" FontWeight="Bold" FontSize="15"
                               Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Nav Actions (center) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                            Padding="14,6" Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13"
                            Command="{Binding ToggleThemeCommand}"
                            Content="🌓  Theme"/>
                    <Button Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                            Padding="14,6" Margin="6,0,0,0" Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold"
                            Command="{Binding AdminLoginCommand}"
                            Content="⚙  Switch User"/>
                    <Button Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                            Padding="14,6" Margin="6,0,0,0" Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13"
                            Command="{Binding LogoutCommand}"
                            Content="← Logout"
                            IsEnabled="{Binding ManageUserViewModel.IsLoggedIn}"/>
                </StackPanel>

                <!-- Window Buttons -->
                <controls:WindowButtonsControl Grid.Column="2" WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <!--#endregion-->

        <Grid
            Grid.Row="1"
            Margin="50,25,50,30"
            Visibility="{Binding ManageUserViewModel.IsLoggedIn, Converter={shared:BoolToVisibilityConverter}}">

            <Border Background="{DynamicResource CardBackgroundBrush}" 
                    CornerRadius="12" 
                    BorderThickness="1" 
                    BorderBrush="{DynamicResource BorderBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Direction="270" Opacity="0.1" ShadowDepth="10" Color="Black" />
                </Border.Effect>
            </Border>
            
            <ContentControl Content="{Binding DashboardViewModel}" Foreground="{DynamicResource PrimaryTextBrush}" Margin="10" />
        </Grid>

        <ContentControl
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Content="{Binding ManageUserViewModel}"
            Foreground="{DynamicResource PrimaryTextBrush}"
            IsTabStop="False"
            Visibility="{Binding ManageUserViewModel.IsLoggedIn, Converter={shared:BoolToVisibilityConverter IsInverse=True}}" />

        <!--#region In-App Toast Notification-->
        <Border Grid.RowSpan="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,60,20,0"
                Padding="15,10"
                Background="{DynamicResource AccentBrush}"
                CornerRadius="8"
                Visibility="{Binding IsNotificationVisible, Converter={shared:BoolToVisibilityConverter}}"
                Panel.ZIndex="100">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" Opacity="0.3" ShadowDepth="5" Color="Black" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="{Binding NotificationTitle}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" Margin="0,0,0,5" />
                <TextBlock Text="{Binding NotificationMessage}" FontSize="12" Foreground="#EEEEEE" TextWrapping="Wrap" MaxWidth="250" />
            </StackPanel>
        </Border>
        <!--#endregion-->

    </Grid>

</Window>

