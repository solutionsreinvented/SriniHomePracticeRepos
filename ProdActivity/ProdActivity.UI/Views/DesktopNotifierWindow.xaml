<Window x:Class="ProdActivity.UI.Views.DesktopNotifierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProdActivity Notifier" 
        Height="150" Width="350"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Border Background="#1E1E2C" CornerRadius="8" BorderBrush="#3B82F6" BorderThickness="2" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.5" Direction="315" ShadowDepth="5"/>
        </Border.Effect>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TextBlock Text="ProdActivity Reminder" FontWeight="Bold" Foreground="#FFFFFF" FontSize="14" />
            
            <TextBlock Grid.Row="1" Text="Don't forget to log your daily project activities." Foreground="#A0A0B0" TextWrapping="Wrap" Margin="0,10,0,0" />
            
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Mark Completed" Click="OnMarkCompletedClick" Background="Transparent" Foreground="#3B82F6" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                <Button Content="Dismiss" Click="OnDismissClick" Background="Transparent" Foreground="#A0A0B0" BorderThickness="0" Cursor="Hand" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
