<Window x:Class="FeaLinux.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FeaLinux.App.Views"
        Title="{Binding Title, Mode=OneWay}"
        Height="900" Width="1600" MinHeight="700" MinWidth="1200"
        WindowState="Maximized"
        Style="{StaticResource FEAWindowStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Menu -->
            <RowDefinition Height="Auto"/>  <!-- Ribbon -->
            <RowDefinition Height="Auto"/>  <!-- Coord Input Bar -->
            <RowDefinition Height="*"/>     <!-- Work Area -->
            <RowDefinition Height="Auto"/>  <!-- Output -->
            <RowDefinition Height="22"/>    <!-- Status -->
        </Grid.RowDefinitions>

        <!-- ═══ ROW 0 — MENU BAR ═══ -->
        <Border Grid.Row="0" Background="{StaticResource Bg0Brush}"
                BorderBrush="{StaticResource Border1Brush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Border DockPanel.Dock="Left" Background="{StaticResource AccentBrush}"
                        Width="34" Height="34" CornerRadius="3" Margin="4,2">
                    <TextBlock Text="FEA" Foreground="White" FontWeight="Bold" FontSize="10"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock DockPanel.Dock="Right" Text="FeaLinux  v1.0 — Structural Analysis &amp; Design"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Menu DockPanel.Dock="Left" VerticalAlignment="Center" Background="Transparent">
                    <MenuItem Header="File">
                        <MenuItem Header="New Project"  Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+N"/>
                        <MenuItem Header="Open Project…" InputGestureText="Ctrl+O"/>
                        <MenuItem Header="Save"          InputGestureText="Ctrl+S"/>
                        <Separator/>
                        <MenuItem Header="Import DXF…"/>
                        <MenuItem Header="Export Results…"/>
                        <Separator/>
                        <MenuItem Header="Exit" Click="MenuExit_Click"/>
                    </MenuItem>
                    <MenuItem Header="Edit">
                        <MenuItem Header="Undo" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z"/>
                        <MenuItem Header="Redo" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y"/>
                        <Separator/>
                        <MenuItem Header="Project Settings…"/>
                    </MenuItem>
                    <MenuItem Header="Model">
                        <MenuItem Header="Add Node"   Command="{Binding SetModeAddNodeCommand}"/>
                        <MenuItem Header="Add Member" Command="{Binding SetModeAddMemberCommand}"/>
                        <MenuItem Header="Add Support" Command="{Binding SetModeAddSupportCommand}"/>
                        <Separator/>
                        <MenuItem Header="Section Library…"/>
                        <MenuItem Header="Material Library…"/>
                    </MenuItem>
                    <MenuItem Header="Loads">
                        <MenuItem Header="Point Load"   Command="{Binding SetModeAddLoadCommand}"/>
                        <MenuItem Header="Distributed Load"/>
                        <Separator/>
                        <MenuItem Header="Load Cases…"/>
                        <MenuItem Header="Load Combinations…"/>
                    </MenuItem>
                    <MenuItem Header="Analysis">
                        <MenuItem Header="Run Analysis" Command="{Binding RunAnalysisCommand}" InputGestureText="F5"/>
                        <Separator/>
                        <MenuItem Header="Analysis Settings…"/>
                    </MenuItem>
                    <MenuItem Header="Results">
                        <MenuItem Header="Deformed Shape" IsCheckable="True" IsChecked="{Binding ShowDeformedShape}"/>
                        <MenuItem Header="Bending Moment Diagram"/>
                        <MenuItem Header="Shear Force Diagram"/>
                        <MenuItem Header="Axial Force Diagram"/>
                        <Separator/>
                        <MenuItem Header="Generate Report…"/>
                    </MenuItem>
                    <MenuItem Header="View">
                        <MenuItem Header="Perspective"  Click="View_Perspective"/>
                        <MenuItem Header="Top (Plan)"   Click="View_Top"/>
                        <MenuItem Header="Front"        Click="View_Front"/>
                        <MenuItem Header="Right Side"   Click="View_Right"/>
                        <MenuItem Header="Fit All"      Click="View_FitAll"/>
                        <Separator/>
                        <MenuItem Header="Show Loads"       IsCheckable="True" IsChecked="{Binding ShowLoads}"/>
                        <MenuItem Header="Show Supports"    IsCheckable="True" IsChecked="{Binding ShowSupports}"/>
                        <MenuItem Header="Show Node Labels" IsCheckable="True" IsChecked="{Binding ShowNodeLabels}"/>
                    </MenuItem>
                </Menu>
            </DockPanel>
        </Border>

        <!-- ═══ ROW 1 — RIBBON ═══ -->
        <Border Grid.Row="1" Background="{StaticResource Bg2Brush}"
                BorderBrush="{StaticResource Border1Brush}" BorderThickness="0,0,0,1">
            <TabControl Style="{StaticResource RibbonTabControlStyle}">

                <!-- HOME -->
                <TabItem Header="HOME" Style="{StaticResource RibbonTabItemStyle}">
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <views:RibbonGroup Header="FILE">
                            <views:RibbonButton Icon="📄" Label="New"  Command="{Binding NewProjectCommand}"/>
                            <views:RibbonButton Icon="📂" Label="Open"/>
                            <views:RibbonButton Icon="💾" Label="Save"/>
                        </views:RibbonGroup>
                        <views:RibbonGroup Header="EDIT">
                            <views:RibbonButton Icon="↩" Label="Undo" Command="{Binding UndoCommand}"/>
                            <views:RibbonButton Icon="↪" Label="Redo" Command="{Binding RedoCommand}"/>
                        </views:RibbonGroup>
                        <views:RibbonGroup Header="ANALYSIS">
                            <Button Style="{StaticResource AccentButtonStyle}"
                                    Command="{Binding RunAnalysisCommand}" Padding="16,6" Margin="4,2"
                                    ToolTip="Run Linear Static Analysis (F5)">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{StaticResource Icon.RunAnalysis}" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="Run Analysis" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                            </Button>
                        </views:RibbonGroup>
                    </StackPanel>
                </TabItem>

                <!-- MODEL -->
                <TabItem Header="MODEL" Style="{StaticResource RibbonTabItemStyle}">
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <views:RibbonGroup Header="GEOMETRY">
                            <views:RibbonIconButton Icon="{StaticResource Icon.Node}"   Label="Node"
                                Command="{Binding SetModeAddNodeCommand}"
                                IsActive="{Binding ActiveMode, Converter={x:Static views:ModeConverter.Instance}, ConverterParameter=AddNode}"
                                ToolTip="Add Node (N)"/>
                            <views:RibbonIconButton Icon="{StaticResource Icon.Member}" Label="Member"
                                Command="{Binding SetModeAddMemberCommand}"
                                IsActive="{Binding ActiveMode, Converter={x:Static views:ModeConverter.Instance}, ConverterParameter=AddMember}"
                                ToolTip="Add Member (M)"/>
                            <views:RibbonIconButton Icon="{StaticResource Icon.Plate}"  Label="Plate"
                                Command="{Binding SetModeAddPlateCommand}"
                                ToolTip="Add Plate (P)"/>
                            <views:RibbonIconButton Icon="{StaticResource Icon.MoveNode}" Label="Move"
                                ToolTip="Move Nodes"/>
                        </views:RibbonGroup>
                        <views:RibbonGroup Header="SUPPORTS">
                            <views:RibbonIconButton Icon="{StaticResource Icon.FixedSupport}"  Label="Fixed"
                                Command="{Binding SetModeAddSupportCommand}"
                                IsActive="{Binding ActiveMode, Converter={x:Static views:ModeConverter.Instance}, ConverterParameter=AddSupport}"
                                ToolTip="Add Fixed Support"/>
                            <views:RibbonIconButton Icon="{StaticResource Icon.PinnedSupport}" Label="Pinned"
                                ToolTip="Add Pinned Support"/>
                        </views:RibbonGroup>
                        <views:RibbonGroup Header="PROPERTIES">
                            <views:RibbonIconButton Icon="{StaticResource Icon.Section}"  Label="Sections"  ToolTip="Section Library"/>
                            <views:RibbonIconButton Icon="{StaticResource Icon.Material}" Label="Materials" ToolTip="Material Library"/>
                        </views:RibbonGroup>
                    </StackPanel>
                </TabItem>

                <!-- LOADS -->
                <TabItem Header="LOADS" Style="{StaticResource RibbonTabItemStyle}">
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <views:RibbonGroup Header="NODAL LOADS">
                            <views:RibbonIconButton Icon="{StaticResource Icon.PointLoad}" Label="Point Load"
                                Command="{Binding SetModeAddLoadCommand}"
                                IsActive="{Binding ActiveMode, Converter={x:Static views:ModeConverter.Instance}, ConverterParameter=AddLoad}"
                                ToolTip="Apply nodal force/moment"/>
                        </views:RibbonGroup>
                        <views:RibbonGroup Header="MEMBER LOADS">
                            <views:RibbonIconButton Icon="{StaticResource Icon.DistributedLoad}" Label="UDL" ToolTip="Uniform Distributed Load"/>
                        </views:RibbonGroup>
                        <views:RibbonGroup Header="CASES">
                            <views:RibbonButton Icon="📋" Label="Cases"   ToolTip="Load Case Manager"/>
                            <views:RibbonButton Icon="🔗" Label="Combos"  ToolTip="Load Combinations"/>
                        </views:RibbonGroup>
                    </StackPanel>
                </TabItem>

                <!-- ANALYSIS -->
                <TabItem Header="ANALYSIS" Style="{StaticResource RibbonTabItemStyle}">
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <views:RibbonGroup Header="RUN">
                            <Button Style="{StaticResource AccentButtonStyle}"
                                    Command="{Binding RunAnalysisCommand}" Padding="12,6" Margin="4,2">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{StaticResource Icon.RunAnalysis}" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="Linear Static" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                            </Button>
                        </views:RibbonGroup>
                        <views:RibbonGroup Header="RESULTS VIEW">
                            <views:RibbonIconButton Icon="{StaticResource Icon.DeformedShape}" Label="Deformed"
                                Command="{Binding ToggleDeformedShapeCommand}" ToolTip="Toggle Deformed Shape"/>
                            <views:RibbonIconButton Icon="{StaticResource Icon.BMD}" Label="BMD" ToolTip="Bending Moment Diagram"/>
                        </views:RibbonGroup>
                        <views:RibbonGroup Header="SCALE">
                            <StackPanel Margin="4,0">
                                <TextBlock Text="Deform Scale" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Slider Value="{Binding DeformationScale}" Minimum="1" Maximum="500"
                                        Width="120" Margin="0,4" VerticalAlignment="Center"/>
                            </StackPanel>
                        </views:RibbonGroup>
                    </StackPanel>
                </TabItem>

                <!-- DESIGN -->
                <TabItem Header="DESIGN" Style="{StaticResource RibbonTabItemStyle}">
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <views:RibbonGroup Header="STEEL">
                            <views:RibbonIconButton Icon="{StaticResource Icon.SteelDesign}" Label="IS 800"   ToolTip="IS 800:2007 Steel Design"/>
                            <views:RibbonIconButton Icon="{StaticResource Icon.SteelDesign}" Label="AISC 360" ToolTip="AISC 360 Steel Design"/>
                        </views:RibbonGroup>
                        <views:RibbonGroup Header="CONCRETE">
                            <views:RibbonIconButton Icon="{StaticResource Icon.ConcreteDesign}" Label="IS 456"  ToolTip="IS 456:2000 RC Design"/>
                            <views:RibbonIconButton Icon="{StaticResource Icon.ConcreteDesign}" Label="ACI 318" ToolTip="ACI 318 RC Design"/>
                        </views:RibbonGroup>
                        <views:RibbonGroup Header="REPORT">
                            <views:RibbonIconButton Icon="{StaticResource Icon.Report}" Label="Report" ToolTip="Generate Design Report"/>
                        </views:RibbonGroup>
                    </StackPanel>
                </TabItem>

                <!-- VIEW -->
                <TabItem Header="VIEW" Style="{StaticResource RibbonTabItemStyle}">
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <views:RibbonGroup Header="CAMERA">
                            <views:RibbonButton Icon="⬡" Label="3D"    Click="View_Perspective"/>
                            <views:RibbonButton Icon="⬜" Label="Plan"  Click="View_Top"/>
                            <views:RibbonButton Icon="▭" Label="Front" Click="View_Front"/>
                            <views:RibbonButton Icon="▯" Label="Side"  Click="View_Right"/>
                            <views:RibbonButton Icon="🔍" Label="Fit"  Click="View_FitAll"/>
                        </views:RibbonGroup>
                        <views:RibbonGroup Header="DISPLAY">
                            <views:RibbonToggle Label="Loads"    IsChecked="{Binding ShowLoads}"/>
                            <views:RibbonToggle Label="Supports" IsChecked="{Binding ShowSupports}"/>
                            <views:RibbonToggle Label="N Labels" IsChecked="{Binding ShowNodeLabels}"/>
                            <views:RibbonToggle Label="M Labels" IsChecked="{Binding ShowMemberLabels}"/>
                        </views:RibbonGroup>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Border>

        <!-- ═══ ROW 2 — COORDINATE INPUT BAR ═══ -->
        <Border Grid.Row="2" x:Name="InputBar"
                Background="{StaticResource AccentBg1Brush}"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding IsInputBarVisible, Mode=OneWay, Converter={x:Static views:BoolToVisConverter.Instance}}">
            <StackPanel Orientation="Horizontal" Margin="8,4">
                <TextBlock Text="{Binding InputBarPrompt, Mode=OneWay}"
                           Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Width="160"/>
                <TextBlock Text="X (m):" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11"/>
                <TextBox x:Name="TbX" Text="{Binding InputX, UpdateSourceTrigger=PropertyChanged}"
                         Width="80" Height="24" Margin="0,0,8,0"/>
                <TextBlock Text="Y (m):" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11"/>
                <TextBox x:Name="TbY" Text="{Binding InputY, UpdateSourceTrigger=PropertyChanged}"
                         Width="80" Height="24" Margin="0,0,8,0"/>
                <TextBlock Text="Z (m):" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11"/>
                <TextBox x:Name="TbZ" Text="{Binding InputZ, UpdateSourceTrigger=PropertyChanged}"
                         Width="80" Height="24" Margin="0,0,12,0"
                         KeyDown="InputBar_KeyDown"/>
                <Button Content="Add Node" Command="{Binding ConfirmAddNodeCommand}"
                        Style="{StaticResource AccentButtonStyle}" Height="26" Padding="10,0"
                        Visibility="{Binding IsAddNodeMode, Mode=OneWay, Converter={x:Static views:BoolToVisConverter.Instance}}"/>
                <Button Content="Set Start Node" Command="{Binding ConfirmMemberStartCommand}"
                        Style="{StaticResource AccentButtonStyle}" Height="26" Padding="10,0" Margin="0,0,4,0"
                        Visibility="{Binding IsAddMemberMode, Mode=OneWay, Converter={x:Static views:BoolToVisConverter.Instance}}"/>
                <TextBlock Text="{Binding MemberStatus, Mode=OneWay}" VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}" FontStyle="Italic" FontSize="11"
                           Visibility="{Binding IsAddMemberMode, Mode=OneWay, Converter={x:Static views:BoolToVisConverter.Instance}}"/>
                <Button Content="Esc — Cancel" Click="CancelMode_Click"
                        Height="26" Padding="10,0" Margin="12,0,0,0"
                        Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- ═══ ROW 3 — MAIN WORK AREA ═══ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52"/>   <!-- Left Vertical Toolbar -->
                <ColumnDefinition Width="220" MinWidth="140"/>  <!-- Model Tree -->
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>    <!-- Viewport -->
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="260" MinWidth="180"/>  <!-- Properties -->
            </Grid.ColumnDefinitions>

            <!-- ── Col 0: Left Vertical Toolbar ── -->
            <Border Grid.Column="0" Background="{StaticResource ToolbarBgBrush}"
                    BorderBrush="{StaticResource ToolbarBorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Select -->
                        <Button Style="{StaticResource ToolSideButtonStyle}"
                                Command="{Binding SetModeSelectCommand}" ToolTip="Select (S)">
                            <Image Source="{StaticResource Icon.Select}" Width="22" Height="22"/>
                        </Button>
                        <Border Height="1" Background="{StaticResource ToolbarBorderBrush}" Margin="8,2"/>
                        <!-- Geometry tools -->
                        <Button Style="{StaticResource ToolSideButtonStyle}"
                                Command="{Binding SetModeAddNodeCommand}" ToolTip="Add Node (N)">
                            <Image Source="{StaticResource Icon.Node}" Width="22" Height="22"/>
                        </Button>
                        <Button Style="{StaticResource ToolSideButtonStyle}"
                                Command="{Binding SetModeAddMemberCommand}" ToolTip="Add Member (M)">
                            <Image Source="{StaticResource Icon.Member}" Width="22" Height="22"/>
                        </Button>
                        <Button Style="{StaticResource ToolSideButtonStyle}"
                                Command="{Binding SetModeAddPlateCommand}" ToolTip="Add Plate">
                            <Image Source="{StaticResource Icon.Plate}" Width="22" Height="22"/>
                        </Button>
                        <Button Style="{StaticResource ToolSideButtonStyle}"
                                ToolTip="Move Node">
                            <Image Source="{StaticResource Icon.MoveNode}" Width="22" Height="22"/>
                        </Button>
                        <Border Height="1" Background="{StaticResource ToolbarBorderBrush}" Margin="8,2"/>
                        <!-- Supports -->
                        <Button Style="{StaticResource ToolSideButtonStyle}"
                                Command="{Binding SetModeAddSupportCommand}" ToolTip="Add Support">
                            <Image Source="{StaticResource Icon.FixedSupport}" Width="22" Height="22"/>
                        </Button>
                        <Border Height="1" Background="{StaticResource ToolbarBorderBrush}" Margin="8,2"/>
                        <!-- Loads -->
                        <Button Style="{StaticResource ToolSideButtonStyle}"
                                Command="{Binding SetModeAddLoadCommand}" ToolTip="Add Point Load">
                            <Image Source="{StaticResource Icon.PointLoad}" Width="22" Height="22"/>
                        </Button>
                        <Button Style="{StaticResource ToolSideButtonStyle}" ToolTip="Add Distributed Load">
                            <Image Source="{StaticResource Icon.DistributedLoad}" Width="22" Height="22"/>
                        </Button>
                        <Border Height="1" Background="{StaticResource ToolbarBorderBrush}" Margin="8,2"/>
                        <!-- Results -->
                        <Button Style="{StaticResource ToolSideButtonStyle}"
                                Command="{Binding ToggleDeformedShapeCommand}" ToolTip="Deformed Shape">
                            <Image Source="{StaticResource Icon.DeformedShape}" Width="22" Height="22"/>
                        </Button>
                        <Button Style="{StaticResource ToolSideButtonStyle}" ToolTip="Bending Moment Diagram">
                            <Image Source="{StaticResource Icon.BMD}" Width="22" Height="22"/>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ── Col 1: Model Tree ── -->
            <Border Grid.Column="1" Background="{StaticResource Bg2Brush}"
                    BorderBrush="{StaticResource Border1Brush}" BorderThickness="0,0,1,0">
                <views:ModelTreeView DataContext="{Binding ModelTreeVM}"/>
            </Border>

            <GridSplitter Grid.Column="2" Width="4" HorizontalAlignment="Stretch" Cursor="SizeWE"/>

            <!-- ── Col 3: 3D Viewport ── -->
            <Border Grid.Column="3" Background="{StaticResource ViewportBgBrush}">
                <views:Viewport3DView DataContext="{Binding ViewportVM}" x:Name="ViewportView"/>
            </Border>

            <GridSplitter Grid.Column="4" Width="4" HorizontalAlignment="Stretch" Cursor="SizeWE"/>

            <!-- ── Col 5: Properties ── -->
            <Border Grid.Column="5" Background="{StaticResource Bg2Brush}"
                    BorderBrush="{StaticResource Border1Brush}" BorderThickness="1,0,0,0">
                <views:PropertiesView DataContext="{Binding PropertiesVM}"/>
            </Border>
        </Grid>

        <!-- ═══ ROW 4 — OUTPUT LOG ═══ -->
        <Border Grid.Row="4" Background="{StaticResource Bg1Brush}"
                BorderBrush="{StaticResource Border1Brush}" BorderThickness="0,1,0,0"
                MaxHeight="140" MinHeight="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="{StaticResource Bg3Brush}"
                        BorderBrush="{StaticResource Border1Brush}" BorderThickness="0,0,0,1">
                    <DockPanel Margin="8,0">
                        <TextBlock Text="OUTPUT LOG" Style="{StaticResource PanelHeaderStyle}"
                                   VerticalAlignment="Center" Margin="0"/>
                        <ProgressBar DockPanel.Dock="Right" Width="160" Height="4" Margin="8,11"
                                     Visibility="{Binding IsAnalysisRunning, Mode=OneWay, Converter={x:Static views:BoolToVisConverter.Instance}}"
                                     IsIndeterminate="{Binding IsAnalysisRunning, Mode=OneWay}"/>
                    </DockPanel>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding StatusMessage, Mode=OneWay}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Margin="8,4" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══ ROW 5 — STATUS BAR ═══ -->
        <StatusBar Grid.Row="5">
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Mode: "/>
                    <Run Text="{Binding ActiveMode, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
            </StatusBarItem>
            <Separator Background="White" Opacity="0.3"/>
            <StatusBarItem>
                <TextBlock Text="{Binding CoordinateDisplay, Mode=OneWay}"
                           FontFamily="{StaticResource MonoFont}"/>
            </StatusBarItem>
            <Separator Background="White" Opacity="0.3"/>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Nodes: "/><Run Text="{Binding Model.Nodes.Count, Mode=OneWay}"/>
                    <Run Text="  Members: "/><Run Text="{Binding Model.Members.Count, Mode=OneWay}"/>
                    <Run Text="  DOF: "/><Run Text="{Binding Model.TotalDof, Mode=OneWay}"/>
                </TextBlock>
            </StatusBarItem>
            <Separator Background="White" Opacity="0.3"/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding Model.AnalysisStatus, Mode=OneWay}"/>
            </StatusBarItem>
            <Separator Background="White" Opacity="0.3"/>
            <StatusBarItem>
                <TextBlock Text="{Binding UnitDisplay, Mode=OneWay}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
