<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════
         NODE — gold sphere with crosshairs
    ═══════════════════════════════════════════════════════ -->
    <DrawingImage x:Key="Icon.Node">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Filled circle -->
                <GeometryDrawing Brush="#FFD700">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="12,12" RadiusX="5" RadiusY="5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Crosshairs -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFD700" Thickness="1.5"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="12,2"  EndPoint="12,7"/>
                            <LineGeometry StartPoint="12,17" EndPoint="12,22"/>
                            <LineGeometry StartPoint="2,12"  EndPoint="7,12"/>
                            <LineGeometry StartPoint="17,12" EndPoint="22,12"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ═══════════════════════════════════════════════════════
         MEMBER — I-section profile (teal)
    ═══════════════════════════════════════════════════════ -->
    <DrawingImage x:Key="Icon.Member">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#4EA8DE">
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M2,4 L22,4 L22,7 L14,7 L14,17 L22,17 L22,20 L2,20 L2,17 L10,17 L10,7 L2,7 Z"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ═══════════════════════════════════════════════════════
         PLATE — parallelogram (purple)
    ═══════════════════════════════════════════════════════ -->
    <DrawingImage x:Key="Icon.Plate">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#7C5CBF" Opacity="0.7"/>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#9D7FE0" Thickness="1.2"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M4,8 L20,5 L20,16 L4,19 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ═══════════════════════════════════════════════════════
         FIXED SUPPORT — triangle + hatch lines
    ═══════════════════════════════════════════════════════ -->
    <DrawingImage x:Key="Icon.FixedSupport">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Triangle -->
                <GeometryDrawing Brush="#F78166">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF6B5B" Thickness="1"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M12,4 L20,18 L4,18 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Ground line + hatch -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#F78166" Thickness="1.5"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="3,19"  EndPoint="21,19"/>
                            <LineGeometry StartPoint="5,20"  EndPoint="3,22"/>
                            <LineGeometry StartPoint="9,20"  EndPoint="7,22"/>
                            <LineGeometry StartPoint="13,20" EndPoint="11,22"/>
                            <LineGeometry StartPoint="17,20" EndPoint="15,22"/>
                            <LineGeometry StartPoint="21,20" EndPoint="19,22"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ═══════════════════════════════════════════════════════
         PINNED SUPPORT — triangle on roller circle
    ═══════════════════════════════════════════════════════ -->
    <DrawingImage x:Key="Icon.PinnedSupport">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Triangle -->
                <GeometryDrawing Brush="#F78166">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF6B5B" Thickness="1"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M12,4 L20,17 L4,17 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Circle -->
                <GeometryDrawing Brush="#F78166">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="12,19.5" RadiusX="2.5" RadiusY="2.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Ground line -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#F78166" Thickness="1.5"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="3,22" EndPoint="21,22"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ═══════════════════════════════════════════════════════
         POINT LOAD — downward arrow (green)
    ═══════════════════════════════════════════════════════ -->
    <DrawingImage x:Key="Icon.PointLoad">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Shaft -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#56D364" Thickness="2.5" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="12,2" EndPoint="12,15"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Arrowhead -->
                <GeometryDrawing Brush="#56D364">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M12,22 L7,14 L17,14 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ═══════════════════════════════════════════════════════
         DISTRIBUTED LOAD — multiple arrows
    ═══════════════════════════════════════════════════════ -->
    <DrawingImage x:Key="Icon.DistributedLoad">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Top bar -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#56D364" Thickness="1.8"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="2,4" EndPoint="22,4"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Vertical shafts -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#56D364" Thickness="1.4"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="5,4"  EndPoint="5,14"/>
                            <LineGeometry StartPoint="10,4" EndPoint="10,14"/>
                            <LineGeometry StartPoint="15,4" EndPoint="15,14"/>
                            <LineGeometry StartPoint="20,4" EndPoint="20,14"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Arrowheads -->
                <GeometryDrawing Brush="#56D364">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <PathGeometry Figures="M5,19  L3,13  L7,13  Z"/>
                            <PathGeometry Figures="M10,19 L8,13  L12,13 Z"/>
                            <PathGeometry Figures="M15,19 L13,13 L17,13 Z"/>
                            <PathGeometry Figures="M20,19 L18,13 L22,13 Z"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ═══════════════════════════════════════════════════════
         SELECT — cursor arrow
    ═══════════════════════════════════════════════════════ -->
    <DrawingImage x:Key="Icon.Select">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#E6EDF3">
                <GeometryDrawing.Pen>
                    <Pen Brush="#30363D" Thickness="1"/>
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M5,2 L5,18 L9,14 L12,21 L14,20 L11,13 L17,13 Z"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ═══════════════════════════════════════════════════════
         SECTION LIBRARY — I-section profile (grey)
    ═══════════════════════════════════════════════════════ -->
    <DrawingImage x:Key="Icon.Section">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#8B949E">
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M3,3 L21,3 L21,6 L14,6 L14,18 L21,18 L21,21 L3,21 L3,18 L10,18 L10,6 L3,6 Z"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ═══════════════════════════════════════════════════════
         MATERIAL — isometric cube (blue)
    ═══════════════════════════════════════════════════════ -->
    <DrawingImage x:Key="Icon.Material">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Top face -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#58A6FF" Opacity="0.9"/>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M12,2 L22,8 L12,14 L2,8 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Left face -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#1F6FEB" Opacity="0.95"/>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M2,8 L12,14 L12,22 L2,16 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Right face -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#388BFD" Opacity="0.95"/>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M22,8 L12,14 L12,22 L22,16 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ═══════════════════════════════════════════════════════
         RUN ANALYSIS — play triangle (green)
    ═══════════════════════════════════════════════════════ -->
    <DrawingImage x:Key="Icon.RunAnalysis">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#3FB950">
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M5,3 L21,12 L5,21 Z"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ═══════════════════════════════════════════════════════
         STEEL DESIGN — I-section + green checkmark
    ═══════════════════════════════════════════════════════ -->
    <DrawingImage x:Key="Icon.SteelDesign">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- I-section -->
                <GeometryDrawing Brush="#6E7681">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M3,3 L21,3 L21,6 L14,6 L14,18 L21,18 L21,21 L3,21 L3,18 L10,18 L10,6 L3,6 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Checkmark overlay -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#3FB950" Thickness="2.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M13,12 L16,16 L21,9"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ═══════════════════════════════════════════════════════
         CONCRETE DESIGN — rectangle with rebar lines
    ═══════════════════════════════════════════════════════ -->
    <DrawingImage x:Key="Icon.ConcreteDesign">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Rectangle body -->
                <GeometryDrawing Brush="#8B949E">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="3,3,18,18" RadiusX="2" RadiusY="2"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Rebar lines -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#F85149" Thickness="1.5"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="7,8"  EndPoint="17,8"/>
                            <LineGeometry StartPoint="7,12" EndPoint="17,12"/>
                            <LineGeometry StartPoint="7,16" EndPoint="17,16"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ═══════════════════════════════════════════════════════
         DEFORMED SHAPE — curved beam over dashed baseline
    ═══════════════════════════════════════════════════════ -->
    <DrawingImage x:Key="Icon.DeformedShape">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Original position (dashed) -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#444C56" Thickness="1.5">
                            <Pen.DashStyle>
                                <DashStyle Dashes="3,2"/>
                            </Pen.DashStyle>
                        </Pen>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="3,19" EndPoint="21,19"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Deformed curve (red) -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF6B6B" Thickness="2" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M3,19 Q12,5 21,19"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ═══════════════════════════════════════════════════════
         MOVE NODE — 4-directional arrows + centre dot
    ═══════════════════════════════════════════════════════ -->
    <DrawingImage x:Key="Icon.MoveNode">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Centre node -->
                <GeometryDrawing Brush="#FFD700">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="12,12" RadiusX="3" RadiusY="3"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 4 arrows -->
                <GeometryDrawing Brush="#E6EDF3">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <!-- Up -->
                            <PathGeometry Figures="M12,2 L9,7 L11,7 L11,9 L13,9 L13,7 L15,7 Z"/>
                            <!-- Down -->
                            <PathGeometry Figures="M12,22 L9,17 L11,17 L11,15 L13,15 L13,17 L15,17 Z"/>
                            <!-- Left -->
                            <PathGeometry Figures="M2,12 L7,9 L7,11 L9,11 L9,13 L7,13 L7,15 Z"/>
                            <!-- Right -->
                            <PathGeometry Figures="M22,12 L17,9 L17,11 L15,11 L15,13 L17,13 L17,15 Z"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ═══════════════════════════════════════════════════════
         BMD — filled parabola above baseline
    ═══════════════════════════════════════════════════════ -->
    <DrawingImage x:Key="Icon.BMD">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Baseline -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#8B949E" Thickness="1.5"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="3,20" EndPoint="21,20"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Filled parabola -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#1F6FEB" Opacity="0.55"/>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#388BFD" Thickness="1.5"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M3,20 Q12,4 21,20 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ═══════════════════════════════════════════════════════
         REPORT — document with text lines
    ═══════════════════════════════════════════════════════ -->
    <DrawingImage x:Key="Icon.Report">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Document body -->
                <GeometryDrawing Brush="#30363D">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#8B949E" Thickness="1"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M5,2 L15,2 L19,6 L19,22 L5,22 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Text lines -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#58A6FF" Thickness="1.2"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="8,9"  EndPoint="16,9"/>
                            <LineGeometry StartPoint="8,12" EndPoint="16,12"/>
                            <LineGeometry StartPoint="8,15" EndPoint="13,15"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
