<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════
         COLOR PALETTE — Professional Dark Engineering Theme
    ═══════════════════════════════════════════════════════════════ -->
    <!-- Backgrounds -->
    <Color x:Key="Bg0Color">#0D1117</Color>    <!-- Deepest background -->
    <Color x:Key="Bg1Color">#161B22</Color>    <!-- Main background -->
    <Color x:Key="Bg2Color">#1C2128</Color>    <!-- Panel background -->
    <Color x:Key="Bg3Color">#21262D</Color>    <!-- Elevated surface -->
    <Color x:Key="Bg4Color">#30363D</Color>    <!-- Card / input background -->
    <Color x:Key="Bg5Color">#373E47</Color>    <!-- Hover surface -->

    <!-- Borders -->
    <Color x:Key="Border1Color">#30363D</Color>
    <Color x:Key="Border2Color">#444C56</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#E6EDF3</Color>
    <Color x:Key="TextSecondary">#8B949E</Color>
    <Color x:Key="TextMuted">#6E7681</Color>
    <Color x:Key="TextDisabled">#484F58</Color>

    <!-- Accent — FEA Blue (inspired by Dlubal) -->
    <Color x:Key="AccentColor">#1F6FEB</Color>
    <Color x:Key="AccentLightColor">#388BFD</Color>
    <Color x:Key="AccentDarkColor">#1158C7</Color>
    <Color x:Key="AccentSubtleColor">#1F3A6E</Color>

    <!-- Semantic -->
    <Color x:Key="SuccessColor">#3FB950</Color>
    <Color x:Key="WarningColor">#D29922</Color>
    <Color x:Key="DangerColor">#F85149</Color>
    <Color x:Key="InfoColor">#58A6FF</Color>

    <!-- Structural element colors -->
    <Color x:Key="NodeColor">#FFD700</Color>
    <Color x:Key="MemberColor">#4EA8DE</Color>
    <Color x:Key="PlateColor">#7C5CBF</Color>
    <Color x:Key="SupportColor">#F78166</Color>
    <Color x:Key="LoadColor">#56D364</Color>
    <Color x:Key="ReactionColor">#FF7043</Color>
    <Color x:Key="DeformedColor">#FF6B6B</Color>

    <!-- Axis colors (matching coordinate system) -->
    <Color x:Key="AxisXColor">#FF4444</Color>   <!-- X = Red -->
    <Color x:Key="AxisYColor">#44FF44</Color>   <!-- Y = Green -->
    <Color x:Key="AxisZColor">#4444FF</Color>   <!-- Z = Blue -->

    <!-- ═══════════════════════════════════════════════════════════════
         BRUSHES
    ═══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="Bg0Brush"         Color="{StaticResource Bg0Color}"/>
    <SolidColorBrush x:Key="Bg1Brush"         Color="{StaticResource Bg1Color}"/>
    <SolidColorBrush x:Key="Bg2Brush"         Color="{StaticResource Bg2Color}"/>
    <SolidColorBrush x:Key="Bg3Brush"         Color="{StaticResource Bg3Color}"/>
    <SolidColorBrush x:Key="Bg4Brush"         Color="{StaticResource Bg4Color}"/>
    <SolidColorBrush x:Key="Bg5Brush"         Color="{StaticResource Bg5Color}"/>
    <SolidColorBrush x:Key="Border1Brush"     Color="{StaticResource Border1Color}"/>
    <SolidColorBrush x:Key="Border2Brush"     Color="{StaticResource Border2Color}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextMutedBrush"   Color="{StaticResource TextMuted}"/>
    <SolidColorBrush x:Key="AccentBrush"      Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}"/>
    <SolidColorBrush x:Key="SuccessBrush"     Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush"     Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush"      Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="InfoBrush"        Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="NodeBrush"        Color="{StaticResource NodeColor}"/>
    <SolidColorBrush x:Key="MemberBrush"      Color="{StaticResource MemberColor}"/>
    <SolidColorBrush x:Key="SupportBrush"     Color="{StaticResource SupportColor}"/>
    <SolidColorBrush x:Key="LoadBrush"        Color="{StaticResource LoadColor}"/>

    <!-- ═══════════════════════════════════════════════════════════════
         TYPOGRAPHY
    ═══════════════════════════════════════════════════════════════ -->
    <FontFamily x:Key="PrimaryFont">Segoe UI, Inter, Arial</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Cascadia Code, Courier New</FontFamily>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeXS">10</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeSM">11</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeMD">12</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeLG">14</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeXL">16</System:Double>

    <!-- ═══════════════════════════════════════════════════════════════
         BASE CONTROL STYLES
    ═══════════════════════════════════════════════════════════════ -->
    <!-- Window -->
    <Style x:Key="FEAWindowStyle" TargetType="Window">
        <Setter Property="Background"  Value="{StaticResource Bg1Brush}"/>
        <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily"  Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize"    Value="{StaticResource FontSizeMD}"/>
    </Style>

    <!-- TextBlock -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize"   Value="{StaticResource FontSizeMD}"/>
    </Style>

    <!-- Panel Section Header -->
    <Style x:Key="PanelHeaderStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize"   Value="{StaticResource FontSizeXS}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin"     Value="8,8,8,4"/>
    </Style>

    <!-- Separator -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource Border1Brush}"/>
        <Setter Property="Height"     Value="1"/>
        <Setter Property="Margin"     Value="0,2"/>
    </Style>

    <!-- ── Button Base ── -->
    <Style x:Key="FEAButtonBase" TargetType="Button">
        <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background"  Value="{StaticResource Bg4Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border1Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"     Value="10,5"/>
        <Setter Property="FontFamily"  Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize"    Value="{StaticResource FontSizeSM}"/>
        <Setter Property="Cursor"      Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource Bg5Brush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent Button (Run Analysis, etc.) -->
    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource FEAButtonBase}">
        <Setter Property="Background"  Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentLightBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── Toolbar Button (icon buttons in ribbon) ── -->
    <Style x:Key="ToolbarButtonStyle" TargetType="Button">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="BorderBrush"      Value="Transparent"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="Foreground"       Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding"          Value="6"/>
        <Setter Property="Margin"           Value="1,2"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="IconPresenter"
                                              Content="{TemplateBinding Tag}"
                                              HorizontalAlignment="Center"/>
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg5Brush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Border2Brush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Active/Toggled toolbar button -->
    <Style x:Key="ActiveToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
        <Setter Property="Background"  Value="{StaticResource AccentSubtleBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ── TextBox ── -->
    <Style TargetType="TextBox">
        <Setter Property="Background"     Value="{StaticResource Bg4Brush}"/>
        <Setter Property="Foreground"     Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush"    Value="{StaticResource Border1Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"        Value="6,4"/>
        <Setter Property="FontFamily"     Value="{StaticResource PrimaryFont}"/>
        <Setter Property="CaretBrush"     Value="{StaticResource AccentLightBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentSubtleBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── ComboBox ── -->
    <Style TargetType="ComboBox">
        <Setter Property="Background"     Value="{StaticResource Bg4Brush}"/>
        <Setter Property="Foreground"     Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush"    Value="{StaticResource Border1Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"        Value="6,3"/>
        <Setter Property="Height"         Value="28"/>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background"  Value="{StaticResource Bg3Brush}"/>
        <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding"     Value="8,4"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── Label ── -->
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize"   Value="{StaticResource FontSizeXS}"/>
        <Setter Property="Padding"    Value="0,0,0,2"/>
    </Style>

    <!-- ── TreeView ── -->
    <Style TargetType="TreeView">
        <Setter Property="Background"     Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground"     Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground"     Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background"     Value="Transparent"/>
        <Setter Property="Padding"        Value="2,2"/>
        <Setter Property="FontFamily"     Value="{StaticResource PrimaryFont}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource AccentLightBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Bg5Brush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── ScrollBar ── -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width"      Value="6"/>
        <Setter Property="MinWidth"   Value="6"/>
    </Style>

    <!-- ── Tab Control (Ribbon Tabs) ── -->
    <Style x:Key="RibbonTabControlStyle" TargetType="TabControl">
        <Setter Property="Background"     Value="{StaticResource Bg2Brush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"        Value="0"/>
    </Style>
    <Style x:Key="RibbonTabItemStyle" TargetType="TabItem">
        <Setter Property="Background"     Value="Transparent"/>
        <Setter Property="Foreground"     Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"        Value="14,6"/>
        <Setter Property="FontSize"       Value="{StaticResource FontSizeSM}"/>
        <Setter Property="FontWeight"     Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg3Brush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Status Bar ── -->
    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{StaticResource Bg0Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="Height"     Value="22"/>
    </Style>
    <Style TargetType="StatusBarItem">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="FontSize"   Value="{StaticResource FontSizeXS}"/>
        <Setter Property="Padding"    Value="8,0"/>
    </Style>

    <!-- ── GridSplitter ── -->
    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{StaticResource Border1Brush}"/>
    </Style>

    <!-- ── ProgressBar ── -->
    <Style TargetType="ProgressBar">
        <Setter Property="Background"  Value="{StaticResource Bg4Brush}"/>
        <Setter Property="Foreground"  Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Height"      Value="4"/>
    </Style>

    <!-- ── DataGrid ── -->
    <Style TargetType="DataGrid">
        <Setter Property="Background"            Value="{StaticResource Bg2Brush}"/>
        <Setter Property="Foreground"            Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush"           Value="{StaticResource Border1Brush}"/>
        <Setter Property="BorderThickness"       Value="1"/>
        <Setter Property="RowBackground"         Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource Bg3Brush}"/>
        <Setter Property="GridLinesVisibility"   Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Border1Brush}"/>
        <Setter Property="ColumnHeaderHeight"    Value="28"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background"  Value="{StaticResource Bg3Brush}"/>
        <Setter Property="Foreground"  Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize"    Value="{StaticResource FontSizeXS}"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="Padding"     Value="8,4"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border1Brush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Foreground"     Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"        Value="8,3"/>
    </Style>

    <!-- ── ToolTip ── -->
    <Style TargetType="ToolTip">
        <Setter Property="Background"     Value="{StaticResource Bg3Brush}"/>
        <Setter Property="Foreground"     Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush"    Value="{StaticResource Border2Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"        Value="8,5"/>
        <Setter Property="FontSize"       Value="{StaticResource FontSizeXS}"/>
    </Style>

    <!-- ── Menu ── -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="{StaticResource Bg0Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource Bg0Brush}"/>
        <Setter Property="Padding"    Value="10,4"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource AccentLightBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── Panel card wrapper ── -->
    <Style x:Key="PanelCardStyle" TargetType="Border">
        <Setter Property="Background"     Value="{StaticResource Bg2Brush}"/>
        <Setter Property="BorderBrush"    Value="{StaticResource Border1Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"   Value="4"/>
        <Setter Property="Margin"         Value="4"/>
    </Style>

    <!-- ── Toggle Button (for select mode indicators) ── -->
    <Style x:Key="ToggleToolStyle" TargetType="ToggleButton">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="BorderBrush"      Value="Transparent"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="Foreground"       Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding"          Value="6"/>
        <Setter Property="Margin"           Value="1,2"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg5Brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
