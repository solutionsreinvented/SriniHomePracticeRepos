<UserControl x:Class="FeaLinux.App.Views.ModelTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{StaticResource Bg3Brush}"
                BorderBrush="{StaticResource Border1Brush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="8,0">
                <TextBlock Text="MODEL BROWSER" Style="{StaticResource PanelHeaderStyle}"
                           VerticalAlignment="Center" Margin="0"/>
                <TextBox DockPanel.Dock="Right" Width="80" Margin="4" VerticalAlignment="Center"
                         FontSize="10" ToolTip="Filter tree…">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{StaticResource Bg2Brush}"
                                                BorderBrush="{StaticResource Border1Brush}"
                                                BorderThickness="1" CornerRadius="3" Padding="4,2">
                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </DockPanel>
        </Border>

        <!-- Tree -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <TreeView>
                <!-- Nodes -->
                <TreeViewItem IsExpanded="True">
                    <TreeViewItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource Icon.Node}" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock>
                                <Run Text="Nodes ("/><Run Text="{Binding Model.Nodes.Count, Mode=OneWay}"/><Run Text=")"/>
                            </TextBlock>
                        </StackPanel>
                    </TreeViewItem.Header>
                    <TreeViewItem.ItemsSource>
                        <Binding Path="Model.Nodes"/>
                    </TreeViewItem.ItemsSource>
                    <TreeViewItem.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="N"/><Run Text="{Binding Id}"/>
                                <Run Text=" (" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Run Text="{Binding X, StringFormat=F2}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Run Text=", " Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Run Text="{Binding Y, StringFormat=F2}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Run Text=", " Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Run Text="{Binding Z, StringFormat=F2}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Run Text=")" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </TextBlock>
                        </DataTemplate>
                    </TreeViewItem.ItemTemplate>
                </TreeViewItem>

                <!-- Members -->
                <TreeViewItem IsExpanded="True">
                    <TreeViewItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource Icon.Member}" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock>
                                <Run Text="Members ("/><Run Text="{Binding Model.Members.Count, Mode=OneWay}"/><Run Text=")"/>
                            </TextBlock>
                        </StackPanel>
                    </TreeViewItem.Header>
                    <TreeViewItem.ItemsSource><Binding Path="Model.Members"/></TreeViewItem.ItemsSource>
                    <TreeViewItem.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="M"/><Run Text="{Binding Id}"/>
                                <Run Text=" N" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Run Text="{Binding StartNode.Id}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Run Text="→N" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Run Text="{Binding EndNode.Id}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </TextBlock>
                        </DataTemplate>
                    </TreeViewItem.ItemTemplate>
                </TreeViewItem>

                <!-- Plates -->
                <TreeViewItem>
                    <TreeViewItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource Icon.Plate}" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock>
                                <Run Text="Plates ("/><Run Text="{Binding Model.Plates.Count, Mode=OneWay}"/><Run Text=")"/>
                            </TextBlock>
                        </StackPanel>
                    </TreeViewItem.Header>
                </TreeViewItem>

                <!-- Sections -->
                <TreeViewItem>
                    <TreeViewItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource Icon.Section}" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock>
                                <Run Text="Sections ("/><Run Text="{Binding Model.Sections.Count, Mode=OneWay}"/><Run Text=")"/>
                            </TextBlock>
                        </StackPanel>
                    </TreeViewItem.Header>
                    <TreeViewItem.ItemsSource><Binding Path="Model.Sections"/></TreeViewItem.ItemsSource>
                    <TreeViewItem.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </DataTemplate>
                    </TreeViewItem.ItemTemplate>
                </TreeViewItem>

                <!-- Materials -->
                <TreeViewItem>
                    <TreeViewItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource Icon.Material}" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock>
                                <Run Text="Materials ("/><Run Text="{Binding Model.Materials.Count, Mode=OneWay}"/><Run Text=")"/>
                            </TextBlock>
                        </StackPanel>
                    </TreeViewItem.Header>
                    <TreeViewItem.ItemsSource><Binding Path="Model.Materials"/></TreeViewItem.ItemsSource>
                    <TreeViewItem.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </DataTemplate>
                    </TreeViewItem.ItemTemplate>
                </TreeViewItem>

                <!-- Supports -->
                <TreeViewItem>
                    <TreeViewItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource Icon.FixedSupport}" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock>
                                <Run Text="Supports ("/><Run Text="{Binding Model.Supports.Count, Mode=OneWay}"/><Run Text=")"/>
                            </TextBlock>
                        </StackPanel>
                    </TreeViewItem.Header>
                    <TreeViewItem.ItemsSource><Binding Path="Model.Supports"/></TreeViewItem.ItemsSource>
                    <TreeViewItem.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                        </DataTemplate>
                    </TreeViewItem.ItemTemplate>
                </TreeViewItem>

                <!-- Load Cases -->
                <TreeViewItem IsExpanded="True">
                    <TreeViewItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" FontSize="13" Margin="0,0,6,0" Foreground="{StaticResource LoadBrush}"/>
                            <TextBlock>
                                <Run Text="Load Cases ("/><Run Text="{Binding Model.LoadCases.Count, Mode=OneWay}"/><Run Text=")"/>
                            </TextBlock>
                        </StackPanel>
                    </TreeViewItem.Header>
                    <TreeViewItem.ItemsSource><Binding Path="Model.LoadCases"/></TreeViewItem.ItemsSource>
                    <TreeViewItem.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="LC"/><Run Text="{Binding Id}"/>
                                <Run Text=": "/><Run Text="{Binding Name}"/>
                            </TextBlock>
                        </DataTemplate>
                    </TreeViewItem.ItemTemplate>
                </TreeViewItem>

                <!-- Results -->
                <TreeViewItem>
                    <TreeViewItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource Icon.BMD}" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Results"/>
                        </StackPanel>
                    </TreeViewItem.Header>
                    <TreeViewItem Header="Displacements"/>
                    <TreeViewItem Header="Reactions"/>
                    <TreeViewItem Header="Member Forces"/>
                    <TreeViewItem Header="Bending Moments"/>
                    <TreeViewItem Header="Shear Forces"/>
                </TreeViewItem>
            </TreeView>
        </ScrollViewer>
    </Grid>
</UserControl>
