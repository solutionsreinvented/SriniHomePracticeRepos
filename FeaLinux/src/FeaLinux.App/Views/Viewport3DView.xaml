<UserControl x:Class="FeaLinux.App.Views.Viewport3DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helix="http://helix-toolkit.org/wpf">
    <Grid>
        <helix:HelixViewport3D x:Name="Viewport"
            Background="#D4D8E0"
            ShowViewCube="True"
            ViewCubeWidth="90"
            ViewCubeOpacity="0.9"
            ShowCoordinateSystem="True"
            CoordinateSystemWidth="70"
            CoordinateSystemLabelForeground="#1C2333"
            IsHeadLightEnabled="True"
            ShowFrameRate="False"
            ZoomAroundMouseDownPoint="True"
            RotateAroundMouseDownPoint="True"
            MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
            MouseMove="Viewport_MouseMove"
            MouseRightButtonDown="Viewport_MouseRightButtonDown">

            <helix:DirectionalHeadLight/>

            <!-- World Grid — centered on origin, XZ plane -->
            <helix:GridLinesVisual3D x:Name="WorldGrid"
                Width="60" Length="60" Thickness="0.012"
                MinorDistance="1" MajorDistance="5"
                Center="0,0,0"/>

            <!-- Structural model visuals -->
            <ModelVisual3D x:Name="StructureRoot"/>
        </helix:HelixViewport3D>

        <!-- Mode indicator — top left -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="10" Padding="8,4" CornerRadius="3"
                Background="#CCFFFFFF"
                BorderBrush="#C0C5CE" BorderThickness="1">
            <TextBlock x:Name="ModeLabel" Text="SELECT"
                       Foreground="#1464C0" FontWeight="SemiBold" FontSize="11"/>
        </Border>

        <!-- Analysis overlay -->
        <Border x:Name="AnalysisOverlay" Visibility="Collapsed"
                Background="#BBD4D8E0">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Running Analysis…"
                           Foreground="#1464C0" FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <ProgressBar Width="320" Height="6" IsIndeterminate="True"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
