<UserControl x:Class="FeaLinux.App.Views.PropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:FeaLinux.Core.Models;assembly=FeaLinux.Core"
             Background="{StaticResource Bg2Brush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Panel header -->
        <Border Background="{StaticResource Bg3Brush}"
                BorderBrush="{StaticResource Border1Brush}" BorderThickness="0,0,0,1">
            <TextBlock Text="{Binding HeaderText, Mode=OneWay}"
                       Style="{StaticResource PanelHeaderStyle}"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ContentControl Content="{Binding SelectedItem}">
                <ContentControl.Resources>

                    <!-- ── NODE properties ── -->
                    <DataTemplate DataType="{x:Type models:Node}">
                        <StackPanel Margin="10">
                            <Border Background="{StaticResource AccentBg1Brush}"
                                    CornerRadius="4" Padding="8,6" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⬤" Foreground="{StaticResource NodeBrush}" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Id, StringFormat='Node N{0}', Mode=OneWay}"
                                               FontWeight="SemiBold" FontSize="13"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="COORDINATES" Style="{StaticResource PanelHeaderStyle}" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="X" Foreground="#C82B2B" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2"
                                         Text="{Binding X, StringFormat=F4, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="m" FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0"/>

                                <TextBlock Grid.Row="1" Text="Y" Foreground="#1D7A3A" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2"
                                         Text="{Binding Y, StringFormat=F4, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="m" FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0"/>

                                <TextBlock Grid.Row="2" Text="Z" Foreground="#1464C0" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2"
                                         Text="{Binding Z, StringFormat=F4, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="m" FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0"/>
                            </Grid>

                            <Separator Margin="0,8"/>
                            <TextBlock Text="LABEL" Style="{StaticResource PanelHeaderStyle}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"/>

                            <Separator Margin="0,8"/>
                            <TextBlock Text="DOF INDEX" Style="{StaticResource PanelHeaderStyle}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding GlobalDofStart, Mode=OneWay, StringFormat='DOF {0}–{1}'}"
                                     IsReadOnly="True"/>
                        </StackPanel>
                    </DataTemplate>

                    <!-- ── MEMBER properties ── -->
                    <DataTemplate DataType="{x:Type models:Member}">
                        <StackPanel Margin="10">
                            <Border Background="{StaticResource AccentBg1Brush}"
                                    CornerRadius="4" Padding="8,6" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="━━" Foreground="{StaticResource MemberBrush}" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Id, StringFormat='Member M{0}', Mode=OneWay}"
                                               FontWeight="SemiBold" FontSize="13"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="CONNECTIVITY" Style="{StaticResource PanelHeaderStyle}" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Start Node" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2"
                                         Text="{Binding StartNode.Id, Mode=OneWay, StringFormat='N{0}'}" IsReadOnly="True"/>
                                <TextBlock Grid.Row="1" Text="End Node" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2"
                                         Text="{Binding EndNode.Id, Mode=OneWay, StringFormat='N{0}'}" IsReadOnly="True"/>
                                <TextBlock Grid.Row="2" Text="Length" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2"
                                         Text="{Binding Length, Mode=OneWay, StringFormat='{}{0:F4} m'}" IsReadOnly="True"/>
                            </Grid>

                            <Separator Margin="0,8"/>
                            <TextBlock Text="SECTION &amp; MATERIAL" Style="{StaticResource PanelHeaderStyle}" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Section" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2"
                                         Text="{Binding Section.Name, Mode=OneWay}" IsReadOnly="True"/>
                                <TextBlock Grid.Row="1" Text="Material" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2"
                                         Text="{Binding Material.Name, Mode=OneWay}" IsReadOnly="True"/>
                                <TextBlock Grid.Row="2" Text="Type" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2"
                                         Text="{Binding MemberType, Mode=OneWay}" IsReadOnly="True"/>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>

                    <!-- ── SUPPORT properties ── -->
                    <DataTemplate DataType="{x:Type models:Support}">
                        <StackPanel Margin="10">
                            <Border Background="#FFF0F0" CornerRadius="4" Padding="8,6" Margin="0,0,0,10"
                                    BorderBrush="{StaticResource SupportBrush}" BorderThickness="1">
                                <TextBlock Text="{Binding Node.Id, StringFormat='Support at Node N{0}', Mode=OneWay}"
                                           FontWeight="SemiBold" FontSize="13"
                                           Foreground="{StaticResource SupportBrush}"/>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Ux" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding Ux, Mode=OneWay}" IsEnabled="False" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Text="Uy" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding Uy, Mode=OneWay}" IsEnabled="False" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Text="Uz" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding Uz, Mode=OneWay}" IsEnabled="False" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="3" Text="Rx" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding Rx, Mode=OneWay}" IsEnabled="False" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="4" Text="Ry" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding Ry, Mode=OneWay}" IsEnabled="False" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="5" Text="Rz" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding Rz, Mode=OneWay}" IsEnabled="False" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>

                </ContentControl.Resources>
            </ContentControl>
        </ScrollViewer>
    </Grid>
</UserControl>
