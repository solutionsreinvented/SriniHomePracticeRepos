<UserControl
    x:Class="Continuum.EquivalentSectionsFinder.Controls.EquivalentSectionsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="http://schemas.reinvented.com/shared"
    x:Name="Root"
    d:DesignHeight="420"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Margin="5">

        <!--#region Grid Definitions-->

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.3*" />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!--#endregion-->

        <!--#region Current Section-->

        <GroupBox
            Grid.Row="0"
            Grid.Column="0"
            Padding="5"
            VerticalAlignment="Stretch"
            Header="Current Section">

            <StackPanel>
                <TextBlock
                    Margin="5,5,5,0"
                    VerticalAlignment="Center"
                    Text="Database:" />
                <ComboBox
                    Height="24"
                    Margin="5"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding Databases}"
                    SelectedItem="{Binding SelectedDatabase}" />
                <TextBlock
                    Margin="5,5,5,0"
                    VerticalAlignment="Center"
                    Text="Shape:" />
                <ComboBox
                    Height="24"
                    Margin="5"
                    DisplayMemberPath="Shape"
                    ItemsSource="{Binding SelectedDatabase.SectionShapes}"
                    SelectedItem="{Binding SelectedShape}" />
                <TextBlock
                    Margin="5,5,5,0"
                    VerticalAlignment="Center"
                    Text="Classification:" />
                <ComboBox
                    Height="24"
                    Margin="5"
                    DisplayMemberPath="Category"
                    ItemsSource="{Binding SelectedShape.Classifications}"
                    SelectedItem="{Binding SelectedClassification}" />
                <TextBlock
                    Margin="5,5,5,0"
                    VerticalAlignment="Center"
                    Text="Section:" />
                <ComboBox
                    Height="24"
                    Margin="5"
                    DisplayMemberPath="Designation"
                    ItemsSource="{Binding SelectedClassification.Sections}"
                    SelectedItem="{Binding SelectedSection}" />
                <TextBlock
                    Margin="5,5,5,0"
                    VerticalAlignment="Center"
                    Text="Allowed percentage difference in property values:" />
                <TextBox
                    Height="24"
                    Margin="5"
                    Padding="2,0"
                    VerticalContentAlignment="Center"
                    shared:TextBoxProperties.SelectAll="True"
                    Text="{Binding PercentDifference, StringFormat={}{0:P2}}" />
                <TextBlock
                    Margin="5,5,5,0"
                    VerticalAlignment="Center"
                    Text="How many properties should match (in percentage):" />
                <TextBox
                    Height="24"
                    Margin="5"
                    Padding="2,0"
                    VerticalContentAlignment="Center"
                    shared:TextBoxProperties.SelectAll="True"
                    Text="{Binding MatchProbabilityPercent, StringFormat={}{0:P2}}" />

                <!--#region Submit Button-->

                <Button
                    Height="24"
                    Margin="5,10,5,5"
                    Command="{Binding CheckForEquivalentSectionsCommand}"
                    Content="Check for Equivalent Sections"
                    IsDefault="True"
                    IsEnabled="{Binding HasValidLookInDatabases}" />

                <!--#endregion-->

            </StackPanel>
        </GroupBox>

        <!--#endregion-->

        <!--#region Look In Databases-->

        <GroupBox
            Grid.Row="0"
            Grid.Column="1"
            Padding="5"
            Header="Search in Databases">

            <StackPanel>
                <ListView
                    Margin="5"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding Databases}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <CheckBox
                                VerticalAlignment="Center"
                                Command="{Binding DataContext.ToggleDatabaseCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <!--<CheckBox.IsEnabled>
                                    <MultiBinding Converter="{shared:BothItemsMatchConverter IsInverted=True}">
                                        <Binding Path="Name" />
                                        <Binding ElementName="Root" Path="DataContext.SelectedDatabase.Name" />
                                    </MultiBinding>
                                </CheckBox.IsEnabled>-->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="3,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{Binding Name}" />
                                </StackPanel>
                                <!--<CheckBox.Style>
                                    <Style TargetType="CheckBox">
                                        <Style.Triggers>
                                -->
                                <!--  Use DataTrigger if you only need to check one condition  -->
                                <!--
                                            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True">
                                                <Setter Property="IsChecked" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </CheckBox.Style>-->
                            </CheckBox>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

        </GroupBox>

        <!--#endregion-->

        <!--#region Equivalent Sections-->

        <GroupBox
            Grid.Row="0"
            Grid.Column="2"
            Header="Equivalent Sections">
            <ListBox
                Margin="5"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding ComparisonResults}"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectedItem="{Binding SelectedComparisonResult}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Target.Designation}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <!--#endregion-->

    </Grid>

</UserControl>
