<UserControl
    x:Class="ReInvented.UI.Controls.ResponseSystemSelectionControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="http://schemas.reinvented.com/shared"
    xmlns:vm="clr-namespace:ReInvented.UI.ViewModels"
    d:DesignHeight="500"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <UserControl.DataContext>
        <vm:ResponseSystemSelectionViewModel />
    </UserControl.DataContext>

    <Grid>
        <Image Source="{Binding IconPath}" />
        <Grid Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.ColumnSpan="2"
                Margin="5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="14"
                Text="{Binding}"
                TextWrapping="Wrap" />

            <ListBox
                Grid.RowSpan="2"
                Width="200"
                Padding="5,0"
                DataContext="{Binding}"
                ItemsSource="{Binding DataTables.DesignCoefficientsAndFactors.SystemGroups}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectedItem="{Binding SelectedSystemGroup}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Margin="0,2" TextWrapping="Wrap">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} : {1}">
                                    <Binding Path="Group" />
                                    <Binding Path="Title" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ListBox
                Grid.RowSpan="2"
                Grid.Column="1"
                Padding="5,0"
                DataContext="{Binding}"
                ItemsSource="{Binding SelectedSystemGroup.Systems}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectedItem="{Binding SelectedForceResistingSystem}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Margin="0,3"
                            Text="{Binding Name}"
                            TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </Grid>
    </Grid>

</UserControl>
