<Window
    x:Class="DevDrive.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:am="clr-namespace:DevDrive.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="900"
    Height="300"
    am:AnimationManager.LoadWindowAnimation="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <Grid>
            <Button
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Click="OpenColorPicker"
                Content="Select Color" />

            <Popup
                x:Name="ColorPopup"
                Width="250"
                Height="250"
                Placement="Mouse"
                StaysOpen="False">
                <Border
                    Background="White"
                    BorderBrush="Black"
                    BorderThickness="1">
                    <!--  Gradient spectrum  -->
                    <Canvas
                        Width="250"
                        Height="250"
                        MouseDown="Canvas_MouseDown">
                        <Rectangle Width="250" Height="250">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="Red" />
                                    <GradientStop Offset="0.2" Color="Yellow" />
                                    <GradientStop Offset="0.4" Color="Green" />
                                    <GradientStop Offset="0.6" Color="Cyan" />
                                    <GradientStop Offset="0.8" Color="Blue" />
                                    <GradientStop Offset="1" Color="Magenta" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Canvas>
                </Border>
            </Popup>

            <TextBlock
                x:Name="SelectedColorText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16" />
        </Grid>
    </Grid>

</Window>
