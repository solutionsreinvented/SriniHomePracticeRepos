<UserControl
    x:Class="ReInvented.Domain.Optimization.Controls.PlatesOptimizationControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="http://schemas.reinvented.com/shared"
    xmlns:vm="clr-namespace:ReInvented.Domain.Optimization.ViewModels"
    x:Name="Root"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.DataContext>
        <vm:PlatesOptimizationViewModel />
    </UserControl.DataContext>

    <GroupBox
        Margin="5"
        DataContext="{Binding Report.Criteria}"
        Header="Criteria">

        <Grid Margin="5">

            <!--#region Grid Definitions-->

            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <!--<RowDefinition />-->
            </Grid.RowDefinitions>

            <!--#endregion-->

            <!--#region Source Staad Model-->

            <Grid
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="5"
                DataContext="{Binding DataContext.Report, ElementName=Root}">

                <!--#region Grid Definitions-->

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="5*" />
                </Grid.ColumnDefinitions>

                <!--#endregion-->

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Source Staad File:" />
                <Grid Grid.Column="1" Height="24">
                    <TextBox
                        HorizontalAlignment="Stretch"
                        IsEnabled="False"
                        Text="{Binding SourceStaadFile}" />
                    <Button
                        Width="24"
                        Margin="1"
                        HorizontalAlignment="Right"
                        Command="{Binding BrowseStaadFileCommand}"
                        Content="..."
                        ToolTip="Browse" />
                </Grid>

            </Grid>

            <!--#endregion-->

            <GroupBox
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Padding="5,0"
                Header="Material">

                <Grid>

                    <!--#region Grid Definitions-->

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <!--#endregion-->

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Table:" />
                    <ComboBox
                        Grid.Column="1"
                        Height="24"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding MaterialsLibrary.Tables}"
                        SelectedItem="{Binding SelectedTable}" />
                    <TextBlock
                        Grid.Column="2"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Text="Material Grade:" />
                    <ComboBox
                        Grid.Column="3"
                        Height="24"
                        Margin="0,5"
                        DisplayMemberPath="Designation"
                        ItemsSource="{Binding SelectedTable.Grades}"
                        SelectedItem="{Binding Grade}" />

                </Grid>

            </GroupBox>

            <GroupBox
                Grid.Row="2"
                Grid.Column="0"
                Padding="5"
                Header="Other">

                <Grid>

                    <!--#region Grid Definitions-->

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--#endregion-->

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Minimum Thickness:" />

                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Height="24"
                        Margin="0,2"
                        Padding="3,0,0,0"
                        HorizontalContentAlignment="Right"
                        VerticalContentAlignment="Center"
                        shared:TextBoxProperties.SelectAll="True"
                        Text="{Binding MinimumThickness, StringFormat={}{0:N1} mm}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Corrosion Allowance:" />

                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Height="24"
                        Margin="0,2"
                        Padding="3,0,0,0"
                        HorizontalContentAlignment="Right"
                        VerticalContentAlignment="Center"
                        shared:TextBoxProperties.SelectAll="True"
                        Text="{Binding CorrosionAllowance, StringFormat={}{0:N1} mm}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Percentage Plates Exceedance:" />

                    <TextBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Height="24"
                        Margin="0,2"
                        Padding="3,0,0,0"
                        HorizontalContentAlignment="Right"
                        VerticalContentAlignment="Center"
                        shared:TextBoxProperties.SelectAll="True"
                        Text="{Binding AllowedPercentPlatesExceedance, StringFormat={}{0:P1}}"
                        ToolTip="How many plates in a group can exceed the permissible stress. Expressed in percentage." />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Material Partial Safety Factor:" />

                    <TextBox
                        Grid.Row="3"
                        Grid.Column="1"
                        Height="24"
                        Margin="0,2"
                        Padding="3,0,0,0"
                        HorizontalContentAlignment="Right"
                        VerticalContentAlignment="Center"
                        shared:TextBoxProperties.SelectAll="True"
                        Text="{Binding PartialFactor, StringFormat={}{0:N2}}" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Permissible Stress:" />

                    <TextBox
                        Grid.Row="4"
                        Grid.Column="1"
                        Height="24"
                        Margin="0,2"
                        Padding="3,0,0,0"
                        HorizontalContentAlignment="Right"
                        VerticalContentAlignment="Center"
                        shared:TextBoxProperties.SelectAll="True"
                        IsEnabled="False"
                        Text="{Binding LimitingStress, Mode=OneWay, StringFormat={}{0:N2} N/mm2}" />
                </Grid>

            </GroupBox>
        </Grid>

    </GroupBox>
</UserControl>
