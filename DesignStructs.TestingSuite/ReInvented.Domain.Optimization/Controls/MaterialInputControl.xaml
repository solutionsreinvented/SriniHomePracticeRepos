<UserControl
    x:Class="ReInvented.Domain.Optimization.Controls.MaterialInputControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="http://schemas.reinvented.com/shared"
    d:DesignHeight="200"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <GroupBox Padding="5" Header="Material">

        <Grid>

            <!--#region Grid Definitions-->

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--#endregion-->

            <!--#region Material Table-->

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="Table:" />
            <ComboBox
                Grid.Row="0"
                Grid.Column="1"
                Height="24"
                Margin="0,2"
                HorizontalContentAlignment="Right"
                DisplayMemberPath="Name"
                ItemsSource="{Binding MaterialsLibrary.Tables}"
                SelectedItem="{Binding SelectedTable}" />

            <!--#endregion-->

            <!--#region Material Grade-->

            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="Material Grade:" />

            <ComboBox
                Grid.Row="1"
                Grid.Column="1"
                Height="24"
                Margin="0,2"
                HorizontalContentAlignment="Right"
                DisplayMemberPath="Designation"
                ItemsSource="{Binding SelectedTable.Grades}"
                SelectedItem="{Binding Grade}" />

            <!--#endregion-->

            <!--#region Partial Safety Factor-->

            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="Material Partial Safety Factor:" />

            <TextBox
                Grid.Row="2"
                Grid.Column="1"
                Height="24"
                Margin="0,2"
                Padding="3,0,10,0"
                HorizontalContentAlignment="Right"
                VerticalContentAlignment="Center"
                shared:TextBoxProperties.SelectAll="True"
                Text="{Binding PartialFactor, StringFormat={}{0:N2}}" />

            <!--#endregion-->

            <!--#region Permissible Stress-->

            <TextBlock
                Grid.Row="3"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="Permissible Stress:" />

            <TextBox
                Grid.Row="3"
                Grid.Column="1"
                Height="24"
                Margin="0,2"
                Padding="3,0,10,0"
                HorizontalContentAlignment="Right"
                VerticalContentAlignment="Center"
                shared:TextBoxProperties.SelectAll="True"
                IsEnabled="False"
                Text="{Binding LimitingStress, Mode=OneWay, StringFormat={}{0:N2} N/mm²}" />

            <!--#endregion-->

        </Grid>

    </GroupBox>

</UserControl>
